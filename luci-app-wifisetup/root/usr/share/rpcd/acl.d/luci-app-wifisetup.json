{
	"luci-app-wifisetup": {
		"description": "Grant access to the Wi-Fi setup page",
		"read": {
			"ubus": {
				"luci.wifisetup": [ "get", "status" ],
				"iwinfo": [ "info", "freqlist", "txpowerlist", "countrylist", "assoclist" ]
			}
		},
		"write": {
			"ubus": {
				"luci.wifisetup": [ "keys", "qrcode", "set_network", "set_extra", "remove_extra", "set_radio", "set_region", "kick", "block", "unblock", "set_schedule" ]
			}
		}
	}
}

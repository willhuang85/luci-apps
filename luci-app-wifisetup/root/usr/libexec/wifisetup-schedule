#!/usr/bin/ucode
// SPDX-License-Identifier: Apache-2.0
//
// wifisetup-schedule off|on   turn Wi-Fi off / on (run by cron)
// wifisetup-schedule sync     write the schedule from /etc/config/wifisetup to cron
// wifisetup-schedule boot     sync, and turn Wi-Fi off if booted inside the off time

'use strict';

import { readfile, writefile, rename, access, mkdir } from 'fs';
import { cursor } from 'uci';
import * as schedule from 'wifisetup.schedule';

const CRONTAB = '/etc/crontabs/root';

function sync(s) {
	const old = readfile(CRONTAB);
	const text = schedule.merge_crontab(old, schedule.cron_lines(s));

	if (text == (old ?? ''))
		return;

	mkdir('/etc/crontabs');
	writefile(CRONTAB + '.wifisetup', text);
	rename(CRONTAB + '.wifisetup', CRONTAB);

	if (access('/etc/init.d/cron')) {
		system('/etc/init.d/cron enable >/dev/null 2>&1');
		system('/etc/init.d/cron restart >/dev/null 2>&1');
	}
}

const s = schedule.load(cursor());

switch (ARGV[0]) {
case 'off':
	if (s.enabled) {
		system('logger -t wifisetup "Wi-Fi off (schedule)"');
		system('/sbin/wifi down');
	}
	break;

case 'on':
	if (s.enabled) {
		system('logger -t wifisetup "Wi-Fi on (schedule)"');
		system('/sbin/wifi up');
	}
	break;

case 'sync':
	sync(s);
	break;

case 'boot':
	sync(s);

	if (schedule.in_off_window(s, localtime())) {
		system('logger -t wifisetup "Wi-Fi off (schedule, after boot)"');
		system('/sbin/wifi down');
	}
	break;

default:
	warn('usage: wifisetup-schedule off|on|sync|boot\n');
	exit(1);
}

// SPDX-License-Identifier: Apache-2.0
//
// rpcd backend for luci-app-tether.
//
// Lets the router use a phone as its internet connection, switched on by
// hand when the main internet is down:
//
//  - USB: the phone's tethering interface is the netifd interface
//    "tether_usb" (DHCP): an iPhone's (ipheth driver, paired by usbmuxd) or
//    an Android phone's (cdc_ncm on recent phones such as Pixels, rndis_host
//    on older ones); a hotplug script keeps its device name current
//  - Wi-Fi: the router joins the phone's hotspot as a client
//    ("tether_sta" in /etc/config/wireless) on the interface "tether_wifi"
//
// Both interfaces are part of the WAN firewall zone, so LAN devices are
// masqueraded through them like through the normal WAN. While tethering is
// on, the main internet interfaces stay up but get a high route metric so
// the phone's default route wins (IPv6-only ones, e.g. wan6, are paused, as
// tethering is set up for IPv4 only); their previous settings are restored when
// tethering is switched off. Keeping the main connection up lets the page
// notice when it works again.

'use strict';

import { access, glob, lsdir, popen, readfile, readlink, realpath } from 'fs';
import { connect } from 'ubus';
import { cursor } from 'uci';

// the tests point these at a fake tree
const SYS = getenv('TETHER_SYSFS') ?? '/sys';
const USBMUXD = getenv('TETHER_USBMUXD') ?? '/usr/sbin/usbmuxd';
const USB_NET = 'tether_usb';
const WIFI_NET = 'tether_wifi';
const STA_SID = 'tether_sta';
const NETS = { usb: USB_NET, wifi: WIFI_NET };
const TETHER_METRIC = '10';
// added to the metric of the main internet while tethering
const MAIN_PENALTY = 1000;
const APPLE_VENDOR = '05ac';
// USB vendor IDs of Android phone makers: recognises a plugged in phone
// before USB tethering is switched on
const ANDROID_VENDORS = {
	'18d1': 'Google', '04e8': 'Samsung', '22b8': 'Motorola', '2a70': 'OnePlus', '2717': 'Xiaomi',
	'0fce': 'Sony', '1004': 'LG', '12d1': 'Huawei', '22d9': 'OPPO', '0bb4': 'HTC'
};
// network drivers of USB tethering and the kind of phone that uses them
const USB_DRIVERS = { ipheth: 'iphone', cdc_ncm: 'android', rndis_host: 'android' };
// protocols that only carry IPv6, paused while tethering
const IPV6_ONLY = { dhcpv6: true, '6in4': true, '6to4': true, '6rd': true };

const BAND_LABELS = { '2g': '2.4 GHz', '5g': '5 GHz', '6g': '6 GHz', '60g': '60 GHz' };
const STA_ENCRYPTIONS = { 'sae-mixed': true, 'sae': true, 'psk2': true, 'psk-mixed': true, 'owe': false, 'none': false };

// Keep the connection outside of the handlers to prevent premature GC.
const ubus = connect();

function as_list(v) {
	if (v == null)
		return [];

	return (type(v) == 'array') ? v : filter(split(`${v}`, /\s+/), length);
}

function settings(uci) {
	return {
		active: uci.get('tether', 'settings', 'active') == '1',
		method: (uci.get('tether', 'settings', 'method') == 'wifi') ? 'wifi' : 'usb',
		wan_zone: uci.get('tether', 'settings', 'wan_zone') || 'wan',
		check_host: uci.get('tether', 'settings', 'check_host') || '1.1.1.1'
	};
}

function ensure_settings(uci) {
	if (uci.get('tether', 'settings') == null)
		uci.set('tether', 'settings', 'settings');
}

function radio_band(s) {
	if (BAND_LABELS[s?.band])
		return s.band;

	return (s?.hwmode == '11a') ? '5g' : '2g';
}

/* --- USB */

function sysread(path) {
	const v = readfile(`${SYS}/${path}`);

	return (v != null) ? trim(v) : null;
}

function module_present(name) {
	return access(`${SYS}/module/${name}`) || length(glob(`/lib/modules/*/${name}.ko`) ?? []) > 0;
}

// Network device of a tethering phone, { dev, kind }; an iPhone wins if
// several are plugged in.
function usb_netdev() {
	let found = null;

	for (let d in sort(lsdir(`${SYS}/class/net`) ?? [])) {
		const drv = match(readlink(`${SYS}/class/net/${d}/device/driver`) ?? '', /([^\/]+)$/)?.[1];
		const kind = USB_DRIVERS[drv];

		if (kind && (!found || (kind == 'iphone' && found.kind != 'iphone')))
			found = { dev: d, kind };
	}

	return found;
}

// { name, kind } of a USB device that is a phone we know, else null
function usb_device_info(dir) {
	const vendor = trim(readfile(`${dir}/idVendor`) ?? '');
	const product = trim(readfile(`${dir}/product`) ?? '');

	if (vendor == APPLE_VENDOR)
		return { name: length(product) ? product : 'iPhone', kind: 'iphone' };

	if (ANDROID_VENDORS[vendor])
		return { name: length(product) ? product : `${ANDROID_VENDORS[vendor]} phone`, kind: 'android' };

	return null;
}

// The plugged in phone: the one behind the tethering device, or else any
// USB device made by a phone maker (USB tethering not switched on yet).
function usb_phone(net) {
	if (net) {
		const dir = realpath(`${SYS}/class/net/${net.dev}/device/..`);
		const info = dir ? usb_device_info(dir) : null;
		const product = dir ? trim(readfile(`${dir}/product`) ?? '') : '';

		return info ?? { name: length(product) ? product : 'Phone', kind: net.kind };
	}

	for (let d in sort(lsdir(`${SYS}/bus/usb/devices`) ?? [])) {
		const info = usb_device_info(`${SYS}/bus/usb/devices/${d}`);

		if (info)
			return info;
	}

	return null;
}

function usb_supported() {
	return {
		iphone: module_present('ipheth') && access(USBMUXD) == true,
		android: module_present('cdc_ncm') || module_present('rndis_host')
	};
}

/* --- interfaces */

function iface_dump() {
	let res = {};

	for (let i in ubus.call('network.interface', 'dump', {})?.interface ?? [])
		res[i.interface] = i;

	return res;
}

function iface_info(dump, name) {
	const i = dump[name];

	if (!i)
		return { interface: name, up: false };

	return {
		interface: name,
		up: !!i.up,
		pending: !!i.pending,
		uptime: i.uptime ?? null,
		device: i.l3_device ?? i.device ?? null,
		address: i['ipv4-address']?.[0]?.address ?? null,
		gateway: filter(i.route ?? [], (r) => r.target == '0.0.0.0')[0]?.nexthop ?? null,
		error: i.errors?.[0]?.code ?? null
	};
}

function wan_zone_sid(uci, zone) {
	let sid = null;

	uci.foreach('firewall', 'zone', (s) => {
		if (s.name == zone && sid == null)
			sid = s['.name'];
	});

	return sid;
}

// The interfaces of the WAN zone other than ours: the "main internet".
function main_ifaces(uci) {
	const sid = wan_zone_sid(uci, settings(uci).wan_zone);
	let list = [];

	if (!sid)
		return list;

	for (let n in as_list(uci.get('firewall', sid, 'network'))) {
		if (n == USB_NET || n == WIFI_NET || uci.get('network', n) != 'interface')
			continue;

		const proto = uci.get('network', n, 'proto');

		push(list, { name: n, proto, ipv6_only: !!IPV6_ONLY[proto] });
	}

	return list;
}

// Creates the two tether interfaces and puts them into the WAN zone.
// Returns the packages it changed.
function ensure_interfaces(uci) {
	let changed = {};

	for (let net in [ USB_NET, WIFI_NET ]) {
		if (uci.get('network', net) == null) {
			uci.set('network', net, 'interface');
			uci.set('network', net, 'proto', 'dhcp');
			uci.set('network', net, 'auto', '0');
			uci.set('network', net, 'metric', TETHER_METRIC);
			changed.network = true;
		}
	}

	const dev = usb_netdev()?.dev;

	if (dev && uci.get('network', USB_NET, 'device') != dev) {
		uci.set('network', USB_NET, 'device', dev);
		changed.network = true;
	}

	const zone = wan_zone_sid(uci, settings(uci).wan_zone);

	if (zone) {
		let nets = as_list(uci.get('firewall', zone, 'network'));
		let add = filter([ USB_NET, WIFI_NET ], (n) => !(n in nets));

		if (length(add)) {
			uci.set('firewall', zone, 'network', [ ...nets, ...add ]);
			changed.firewall = true;
		}
	}

	return changed;
}

// Lowers the priority of the main internet; remembers what it was.
function deprioritise_main(uci) {
	let saved = [], pause = [];

	for (let m in main_ifaces(uci)) {
		if (m.ipv6_only) {
			push(saved, `${m.name}|auto|${uci.get('network', m.name, 'auto') ?? '-'}`);
			uci.set('network', m.name, 'auto', '0');
			push(pause, m.name);
		}
		else {
			const cur = uci.get('network', m.name, 'metric');
			const n = match(cur ?? '', /^[0-9]+$/) ? +cur : 0;

			push(saved, `${m.name}|metric|${cur ?? '-'}`);
			uci.set('network', m.name, 'metric', `${n + MAIN_PENALTY}`);
		}
	}

	if (length(saved))
		uci.set('tether', 'settings', 'saved', saved);

	return pause;
}

// Puts the main internet back the way it was; returns paused interfaces
// that should come up again.
function restore_main(uci) {
	let resume = [];

	for (let e in as_list(uci.get('tether', 'settings', 'saved'))) {
		const p = split(e, '|');

		if (length(p) != 3 || uci.get('network', p[0]) != 'interface' || (p[1] != 'metric' && p[1] != 'auto'))
			continue;

		if (p[2] == '-')
			uci.delete('network', p[0], p[1]);
		else
			uci.set('network', p[0], p[1], p[2]);

		if (p[1] == 'auto' && p[2] != '0')
			push(resume, p[0]);
	}

	uci.delete('tether', 'settings', 'saved');

	return resume;
}

function shell_quote(s) {
	return "'" + replace(`${s}`, "'", "'\\''") + "'";
}

// Firewall reloads (and Passwall restarts) of all luci-apps go through this
// lock, one at a time: a firewall reload in the middle of a Passwall restart
// re-adds Passwall's rules after Passwall removed them, and they then stay
// behind while Passwall is off, cutting off the router's own connections.
//
// The lock is held on file descriptor 9 of a subshell and the commands run
// with it closed: daemons a command starts (Passwall's xray, dnsmasq, ...)
// would otherwise inherit it and hold the lock for as long as they run,
// blocking every later reload. The "; true" keeps the shell from running the
// last command in place of the subshell, which would close the lock early.
const FW_LOCK = '/var/lock/luci-apps.lock';

// The commands as one script; failures end up in the system log.
function locked_script(cmds) {
	return join('; ', map(cmds, (c) => `${c} || logger -t luci-apps ${shell_quote(`failed: ${c}`)}`));
}

// Runs `cmds` in the background under the lock, after `delay` seconds.
function run_locked(cmds, delay) {
	if (!length(cmds))
		return;

	system(`(${delay ? `sleep ${delay}; ` : ''}mkdir -p /var/lock; exec 9>${FW_LOCK}; flock 9; sh -c ${shell_quote(locked_script(cmds))} 9>&-; true) >/dev/null 2>&1 &`);
}

// Commits and applies the changes shortly after the reply was sent (a
// change on a radio drops Wi-Fi clients, maybe the browser).
function apply(uci, packages, up, down) {
	let cmds = [];

	for (let pkg in packages)
		uci.commit(pkg);

	if ('network' in packages || 'wireless' in packages)
		push(cmds, 'ubus call network reload');

	if ('firewall' in packages)
		push(cmds, '/etc/init.d/firewall reload');

	for (let i in down ?? [])
		push(cmds, `ubus call network.interface down '{"interface":"${i}"}'`);

	for (let i in up ?? [])
		push(cmds, `ubus call network.interface up '{"interface":"${i}"}'`);

	run_locked(cmds, 1);
}

/* --- Wi-Fi hotspot */

function sta_config(uci) {
	const s = uci.get_all('wireless', STA_SID);

	if (!s)
		return { configured: false };

	const radio = uci.get_all('wireless', s.device);

	return {
		configured: !!length(s.ssid ?? ''),
		ssid: s.ssid ?? '',
		key: s.key ?? '',
		encryption: STA_ENCRYPTIONS[s.encryption] != null ? s.encryption : 'sae-mixed',
		radio: s.device,
		band: radio ? radio_band(radio) : null,
		band_label: radio ? BAND_LABELS[radio_band(radio)] : null,
		radio_disabled: radio?.disabled == '1'
	};
}

// Client interface of the hotspot connection while it is up. Whether it is
// associated (and the signal) the page asks iwinfo: iwinfo is served by
// rpcd, which this plugin runs in, so calling it from here would block rpcd.
function sta_ifname() {
	const st = ubus.call('network.wireless', 'status', {}) ?? {};

	for (let radio, r in st)
		for (let i in r.interfaces ?? [])
			if (i.section == STA_SID && i.ifname)
				return i.ifname;

	return null;
}

function own_ssids(uci) {
	let list = [];

	uci.foreach('wireless', 'wifi-iface', (s) => {
		if ((s.mode ?? 'ap') == 'ap' && s.ssid && !(s.ssid in list))
			push(list, s.ssid);
	});

	return list;
}

function radios(uci) {
	let list = [];

	uci.foreach('wireless', 'wifi-device', (s) => {
		push(list, { id: s['.name'], band: radio_band(s), label: BAND_LABELS[radio_band(s)], enabled: s.disabled != '1' });
	});

	return list;
}

function check_ssid(ssid) {
	if (type(ssid) != 'string' || !length(ssid))
		return 'Enter the hotspot name';

	if (length(ssid) > 32)
		return 'The hotspot name can be at most 32 bytes long';

	return null;
}

function check_key(key, enc) {
	if (!STA_ENCRYPTIONS[enc])
		return null;

	if (type(key) != 'string' || length(key) < 8 || length(key) > 63)
		return 'The hotspot password is 8 to 63 characters long';

	for (let i = 0; i < length(key); i++)
		if (ord(key, i) < 0x20 || ord(key, i) > 0x7e)
			return 'The password can only contain letters, digits, spaces and the usual symbols';

	return null;
}

function rx_tx(dev) {
	if (!dev)
		return { rx_bytes: null, tx_bytes: null };

	const rx = sysread(`class/net/${dev}/statistics/rx_bytes`);
	const tx = sysread(`class/net/${dev}/statistics/tx_bytes`);

	return { rx_bytes: (rx != null) ? +rx : null, tx_bytes: (tx != null) ? +tx : null };
}

const methods = {
	/*
	 * Everything the page shows: whether tethering is on, the state of the
	 * phone over USB and Wi-Fi, and of the main internet.
	 */
	status: {
		call: function() {
			const uci = cursor();
			const s = settings(uci);
			const dump = iface_dump();
			const net = usb_netdev();
			const sup = usb_supported();
			const sta = sta_config(uci);

			let tether = {};

			for (let m, net in NETS) {
				tether[m] = iface_info(dump, net);
				tether[m] = { ...tether[m], ...rx_tx(tether[m].device) };
			}

			return {
				active: s.active,
				method: s.method,
				usb: {
					supported: sup.iphone || sup.android,
					iphone_support: sup.iphone,
					android_support: sup.android,
					phone: usb_phone(net),
					netdev: net?.dev,
					carrier: net ? sysread(`class/net/${net.dev}/carrier`) == '1' : false,
					...tether.usb
				},
				wifi: { ...sta, sta_ifname: sta.configured ? sta_ifname() : null, ...tether.wifi },
				main: map(main_ifaces(uci), (m) => ({ ...iface_info(dump, m.name), proto: m.proto, ipv6_only: m.ipv6_only })),
				radios: radios(uci),
				// the router's own networks, left out of the hotspot search
				own_ssids: own_ssids(uci),
				check_host: s.check_host
			};
		}
	},

	/*
	 * Tests whether the main internet works, by pinging through its device
	 * (this works while tethering too, the main connection stays up).
	 */
	check_main: {
		call: function() {
			const uci = cursor();
			const host = settings(uci).check_host;
			const dump = iface_dump();

			if (!match(host, /^[0-9A-Za-z.:-]+$/))
				return { error: 'Invalid check host' };

			for (let m in main_ifaces(uci)) {
				if (m.ipv6_only)
					continue;

				const i = iface_info(dump, m.name);

				if (!i.up || !i.device)
					continue;

				const p = popen(`ping -4 -q -c 2 -W 2 -I ${i.device} ${host} 2>/dev/null`, 'r');
				const out = p ? p.read('all') : '';

				p?.close();

				const rtt = match(out ?? '', /= [0-9.]+\/([0-9.]+)\//);

				return { ok: rtt != null, interface: m.name, rtt: rtt ? +rtt[1] : null };
			}

			return { ok: false, interface: null, reason: 'down' };
		}
	},

	// Hotspot to join for Wi-Fi tethering.
	set_wifi: {
		args: { ssid: '', key: '', encryption: '', radio: '' },
		call: function(req) {
			const uci = cursor();
			const a = req.args;
			let err;

			if (STA_ENCRYPTIONS[a.encryption] == null)
				return { error: 'Unknown security mode' };

			if ((err = check_ssid(a.ssid)) || (err = check_key(a.key, a.encryption)))
				return { error: err };

			if (uci.get('wireless', a.radio) != 'wifi-device')
				return { error: 'Pick the band to use' };

			const s = settings(uci);
			const live = s.active && s.method == 'wifi';
			let changed = ensure_interfaces(uci);

			if (uci.get('wireless', STA_SID) == null)
				uci.set('wireless', STA_SID, 'wifi-iface');

			uci.set('wireless', STA_SID, 'device', a.radio);
			uci.set('wireless', STA_SID, 'mode', 'sta');
			uci.set('wireless', STA_SID, 'network', WIFI_NET);
			uci.set('wireless', STA_SID, 'ssid', a.ssid);
			uci.set('wireless', STA_SID, 'encryption', a.encryption);

			if (STA_ENCRYPTIONS[a.encryption])
				uci.set('wireless', STA_SID, 'key', a.key);
			else
				uci.delete('wireless', STA_SID, 'key');

			if (!live)
				uci.set('wireless', STA_SID, 'disabled', '1');

			let packages = [ 'wireless', ...keys(changed) ];

			for (let pkg in packages)
				uci.save(pkg);

			if (live) {
				apply(uci, packages, [ WIFI_NET ], []);
			}
			else {
				for (let pkg in packages)
					uci.commit(pkg);

				if (changed.firewall)
					run_locked([ '/etc/init.d/firewall reload' ], 0);
			}

			return { result: true };
		}
	},

	/*
	 * Switches the router's internet to the phone (`method` usb or wifi),
	 * or from one method to the other while tethering.
	 */
	start: {
		args: { method: '' },
		call: function(req) {
			const uci = cursor();
			const method = req.args.method;
			const s = settings(uci);

			if (!NETS[method])
				return { error: 'Unknown method' };

			if (method == 'usb') {
				const sup = usb_supported();

				if (!sup.iphone && !sup.android)
					return { error: 'USB tethering support is not installed (packages kmod-usb-net-ipheth, usbmuxd, kmod-usb-net-cdc-ncm, kmod-usb-net-rndis)' };
			}

			if (method == 'wifi') {
				const sta = sta_config(uci);

				if (!sta.configured)
					return { error: 'Enter the name and password of the phone\'s hotspot first' };

				if (sta.radio_disabled)
					return { error: `The ${sta.band_label} band is switched off; turn it on or pick another band` };
			}

			if (!wan_zone_sid(uci, s.wan_zone))
				return { error: `Firewall zone "${s.wan_zone}" not found` };

			ensure_settings(uci);

			const changed = ensure_interfaces(uci);
			let pause = [];

			if (!s.active)
				pause = deprioritise_main(uci);

			const net = NETS[method], other = NETS[(method == 'usb') ? 'wifi' : 'usb'];

			uci.set('network', net, 'auto', '1');
			uci.set('network', other, 'auto', '0');

			if (uci.get('wireless', STA_SID) != null) {
				if (method == 'wifi')
					uci.delete('wireless', STA_SID, 'disabled');
				else
					uci.set('wireless', STA_SID, 'disabled', '1');
			}

			uci.set('tether', 'settings', 'active', '1');
			uci.set('tether', 'settings', 'method', method);

			let packages = [ 'network', 'wireless', 'tether' ];

			if (changed.firewall)
				push(packages, 'firewall');

			for (let pkg in packages)
				uci.save(pkg);

			apply(uci, packages, [ net ], [ other, ...pause ]);

			return { result: true, method };
		}
	},

	// Back to the main internet.
	stop: {
		call: function() {
			const uci = cursor();

			ensure_settings(uci);

			const resume = settings(uci).active ? restore_main(uci) : [];

			for (let net in [ USB_NET, WIFI_NET ])
				if (uci.get('network', net) != null)
					uci.set('network', net, 'auto', '0');

			if (uci.get('wireless', STA_SID) != null)
				uci.set('wireless', STA_SID, 'disabled', '1');

			uci.set('tether', 'settings', 'active', '0');

			for (let pkg in [ 'network', 'wireless', 'tether' ])
				uci.save(pkg);

			apply(uci, [ 'network', 'wireless', 'tether' ], resume, [ USB_NET, WIFI_NET ]);

			return { result: true };
		}
	}
};

return { 'luci.tether': methods };

// SPDX-License-Identifier: Apache-2.0
//
// rpcd backend for luci-app-wgclient.
//
// Every imported profile is a regular netifd "wireguard" interface named
// "wgc_<slug>" in /etc/config/network, with its peers stored in
// "wireguard_wgc_<slug>" sections. All profiles share the firewall zone
// "wgclient". The kill switch is a firewall rule rejecting all forwarded
// traffic from the LAN zone to the WAN zone, so LAN clients can only reach
// the internet through the tunnel.
//
// Routing is policy based (like wg-quick) so that transparent proxies such as
// Passwall, Passwall2, HomeProxy or OpenClash keep working and can even wrap
// the WireGuard tunnel itself:
//
//  - the tunnel's routes live in their own table (default 51820)
//  - "lookup main suppress_prefixlength 0" keeps LAN and other specific routes
//  - only packets whose mark has no bits in bypass_mask (default 0xff) are
//    sent to the VPN table; proxy cores mark their own sockets (Xray and
//    sing-box in Passwall use mark 255), so their upstream connections leave
//    via WAN instead of looping into the tunnel
//  - WireGuard's own UDP packets carry fwmark 0xca6c: they bypass the VPN
//    table too, and since the low byte is not 0xff a proxy's OUTPUT rules can
//    still intercept them, which is what "wrapping" the tunnel means

'use strict';

import { access, popen, readfile, writefile } from 'fs';
import { connect } from 'ubus';
import { cursor } from 'uci';
import * as conf from 'wgclient.conf';

const PREFIX = 'wgc_';
const ZONE = 'wgclient';
const ZONE_SID = 'wgclient_zone';
const FWD_SID = 'wgclient_fwd';
const KS_SID = 'wgclient_killswitch';
const RULE_SIDS = {
	rule: [ 'wgclient_rule_main', 'wgclient_rule_vpn' ],
	rule6: [ 'wgclient_rule6_main', 'wgclient_rule6_vpn' ]
};

// uci config of known transparent proxy apps
const PROXY_APPS = {
	passwall: 'Passwall', passwall2: 'Passwall 2', homeproxy: 'HomeProxy', openclash: 'OpenClash'
};

// Keep the connection outside of the handlers to prevent premature GC.
const ubus = connect();

function shell_quote(s) {
	return "'" + replace(`${s}`, "'", "'\\''") + "'";
}

function run(cmd) {
	const p = popen(`${cmd} 2>/dev/null`, 'r');

	if (!p)
		return null;

	const out = p.read('all');
	p.close();

	return out;
}

function as_list(v) {
	if (v == null)
		return [];

	return (type(v) == 'array') ? v : [ v ];
}

function opt_uint(uci, name, def, min, max) {
	const v = uci.get('wgclient', 'settings', name);
	const n = match(v ?? '', /^(0x[0-9a-fA-F]+|[0-9]+)$/) ? int(v, index(v, '0x') == 0 ? 16 : 10) : null;

	return (n != null && n >= min && n <= max) ? n : def;
}

function settings(uci) {
	let table = opt_uint(uci, 'route_table', 51820, 1, 0x7fffffff);

	// never hijack the reserved local/main/default tables
	if (table >= 253 && table <= 255)
		table = 51820;

	return {
		killswitch: uci.get('wgclient', 'settings', 'killswitch') == '1',
		lan_zone: uci.get('wgclient', 'settings', 'lan_zone') || 'lan',
		wan_zone: uci.get('wgclient', 'settings', 'wan_zone') || 'wan',
		route_table: table,
		rule_priority: opt_uint(uci, 'rule_priority', 30100, 1000, 32000),
		bypass_mask: opt_uint(uci, 'bypass_mask', 0xff, 1, 0xffffffff),
		wg_fwmark: opt_uint(uci, 'wg_fwmark', 0xca6c, 1, 0xffffffff)
	};
}

function detect_proxy_apps(uci) {
	let found = [];

	for (let cfg, name in PROXY_APPS)
		if (uci.get_all(cfg) != null)
			push(found, name);

	return found;
}

function profile_ids(uci) {
	let ids = [];

	uci.foreach('network', 'interface', (s) => {
		if (index(s['.name'], PREFIX) == 0 && s.proto == 'wireguard')
			push(ids, s['.name']);
	});

	return ids;
}

function is_profile(uci, id) {
	return type(id) == 'string' && index(id, PREFIX) == 0 &&
		uci.get('network', id) == 'interface' &&
		uci.get('network', id, 'proto') == 'wireguard';
}

function slugify(uci, label) {
	let slug = substr(replace(lc(label ?? ''), /[^a-z0-9]/g, ''), 0, 11);

	if (!length(slug))
		slug = 'vpn';

	let id = PREFIX + slug;

	// interface names double as Linux device names: max. 15 characters
	for (let n = 2; uci.get('network', id) != null; n++)
		id = PREFIX + substr(slug, 0, 11 - length(`${n}`)) + n;

	return id;
}

function zone_exists(uci, name) {
	let found = false;

	uci.foreach('firewall', 'zone', (s) => {
		if (s.name == name)
			found = true;
	});

	return found;
}

// Reads a profile back from uci into the structure used by conf.uc.
function load_profile(uci, id) {
	let peers = [];

	uci.foreach('network', `wireguard_${id}`, (s) => {
		push(peers, {
			public_key: s.public_key,
			preshared_key: s.preshared_key,
			endpoint_host: s.endpoint_host,
			endpoint_port: s.endpoint_port ? +s.endpoint_port : null,
			allowed_ips: as_list(s.allowed_ips),
			persistent_keepalive: s.persistent_keepalive ? +s.persistent_keepalive : null
		});
	});

	return {
		iface: {
			private_key: uci.get('network', id, 'private_key'),
			addresses: as_list(uci.get('network', id, 'addresses')),
			dns: as_list(uci.get('network', id, 'dns')),
			dns_search: as_list(uci.get('network', id, 'dns_search')),
			mtu: uci.get('network', id, 'mtu') ? +uci.get('network', id, 'mtu') : null,
			listen_port: uci.get('network', id, 'listen_port') ? +uci.get('network', id, 'listen_port') : null
		},
		peers
	};
}

function write_profile(uci, id, cfg, auto) {
	let old_peers = [];

	uci.foreach('network', `wireguard_${id}`, (s) => push(old_peers, s['.name']));

	for (let sid in old_peers)
		uci.delete('network', sid);

	// clear the options in place to keep the section's position (= list order)
	if (uci.get('network', id) == 'interface') {
		for (let opt in keys(uci.get_all('network', id)))
			if (index(opt, '.') != 0)
				uci.delete('network', id, opt);
	}
	else {
		uci.set('network', id, 'interface');
	}

	uci.set('network', id, 'proto', 'wireguard');
	uci.set('network', id, 'private_key', cfg.iface.private_key);
	uci.set('network', id, 'addresses', cfg.iface.addresses);
	uci.set('network', id, 'auto', auto ? '1' : '0');

	if (length(cfg.iface.dns))
		uci.set('network', id, 'dns', cfg.iface.dns);

	if (length(cfg.iface.dns_search))
		uci.set('network', id, 'dns_search', cfg.iface.dns_search);

	if (cfg.iface.mtu)
		uci.set('network', id, 'mtu', `${cfg.iface.mtu}`);

	if (cfg.iface.listen_port)
		uci.set('network', id, 'listen_port', `${cfg.iface.listen_port}`);

	for (let p in cfg.peers) {
		const sid = uci.add('network', `wireguard_${id}`);

		uci.set('network', sid, 'public_key', p.public_key);
		uci.set('network', sid, 'route_allowed_ips', '1');

		if (p.preshared_key)
			uci.set('network', sid, 'preshared_key', p.preshared_key);

		if (p.endpoint_host) {
			uci.set('network', sid, 'endpoint_host', p.endpoint_host);
			uci.set('network', sid, 'endpoint_port', `${p.endpoint_port ?? 51820}`);
		}

		if (length(p.allowed_ips))
			uci.set('network', sid, 'allowed_ips', conf.expand_default_routes(p.allowed_ips));

		if (p.persistent_keepalive)
			uci.set('network', sid, 'persistent_keepalive', `${p.persistent_keepalive}`);
	}
}

function set_routing_opts(uci, id) {
	const s = settings(uci);

	uci.set('network', id, 'ip4table', `${s.route_table}`);
	uci.set('network', id, 'ip6table', `${s.route_table}`);
	uci.set('network', id, 'fwmark', sprintf('0x%x', s.wg_fwmark));
}

// Creates or removes the policy routing rules shared by all profiles and
// makes sure every profile routes into the VPN table.
function sync_routing(uci) {
	const s = settings(uci);
	const ids = profile_ids(uci);

	for (let t, sids in RULE_SIDS) {
		if (!length(ids)) {
			for (let sid in sids)
				uci.delete('network', sid);

			continue;
		}

		uci.set('network', sids[0], t);
		uci.set('network', sids[0], 'lookup', 'main');
		uci.set('network', sids[0], 'suppress_prefixlength', '0');
		uci.set('network', sids[0], 'priority', `${s.rule_priority}`);

		uci.set('network', sids[1], t);
		uci.set('network', sids[1], 'mark', sprintf('0x0/0x%x', s.bypass_mask));
		uci.set('network', sids[1], 'lookup', `${s.route_table}`);
		uci.set('network', sids[1], 'priority', `${s.rule_priority + 10}`);
	}

	for (let id in ids)
		set_routing_opts(uci, id);

	uci.save('network');
}

// Creates or refreshes the firewall zone, forwarding and kill switch rule.
function sync_firewall(uci) {
	const s = settings(uci);
	const ids = profile_ids(uci);

	uci.set('firewall', ZONE_SID, 'zone');
	uci.set('firewall', ZONE_SID, 'name', ZONE);
	uci.set('firewall', ZONE_SID, 'input', 'REJECT');
	uci.set('firewall', ZONE_SID, 'output', 'ACCEPT');
	uci.set('firewall', ZONE_SID, 'forward', 'REJECT');
	uci.set('firewall', ZONE_SID, 'masq', '1');
	uci.set('firewall', ZONE_SID, 'masq6', '1');
	uci.set('firewall', ZONE_SID, 'mtu_fix', '1');

	if (length(ids))
		uci.set('firewall', ZONE_SID, 'network', ids);
	else
		uci.delete('firewall', ZONE_SID, 'network');

	uci.set('firewall', FWD_SID, 'forwarding');
	uci.set('firewall', FWD_SID, 'src', s.lan_zone);
	uci.set('firewall', FWD_SID, 'dest', ZONE);

	// Rules are evaluated before zone forwardings, so this rejects LAN -> WAN
	// traffic even though a lan -> wan forwarding exists.
	uci.set('firewall', KS_SID, 'rule');
	uci.set('firewall', KS_SID, 'name', 'WireGuard client kill switch');
	uci.set('firewall', KS_SID, 'src', s.lan_zone);
	uci.set('firewall', KS_SID, 'dest', s.wan_zone);
	uci.set('firewall', KS_SID, 'proto', 'all');
	uci.set('firewall', KS_SID, 'family', 'any');
	uci.set('firewall', KS_SID, 'target', 'REJECT');
	uci.set('firewall', KS_SID, 'enabled', s.killswitch ? '1' : '0');

	uci.save('firewall');
}

function apply(uci, packages) {
	for (let pkg in packages)
		uci.commit(pkg);

	if ('network' in packages)
		ubus.call('network', 'reload', {});

	if ('firewall' in packages)
		system('/etc/init.d/firewall reload >/dev/null 2>&1');
}

function iface_up(id) {
	ubus.call('network.interface', 'up', { interface: id });
}

function iface_down(id) {
	ubus.call('network.interface', 'down', { interface: id });
}

function runtime_status() {
	let wg = {}, ifaces = {};

	// interface line: name, privkey, pubkey, port, fwmark
	// peer line: name, pubkey, psk, endpoint, allowed, handshake, rx, tx, keepalive
	for (let line in split(run('wg show all dump') ?? '', '\n')) {
		const f = split(line, '\t');

		if (length(f) == 5)
			wg[f[0]] = { public_key: f[2], peers: [] };
		else if (length(f) == 9 && wg[f[0]])
			push(wg[f[0]].peers, {
				public_key: f[1],
				endpoint: (f[3] != '(none)') ? f[3] : null,
				latest_handshake: +f[5],
				rx_bytes: +f[6],
				tx_bytes: +f[7]
			});
	}

	for (let i in ubus.call('network.interface', 'dump', {})?.interface)
		ifaces[i.interface] = i;

	return { wg, ifaces };
}

/*
 * "Tunnel through Passwall": configures Passwall so that WireGuard's own
 * packets are wrapped by the proxy, and undoes it again. Every Passwall
 * value that gets changed is saved in wgclient.passwall first (UNSET marks
 * an option that did not exist), list entries are tagged, so turning the
 * feature off restores the previous state exactly.
 */
const PW_RULES = '/etc/passwall/rules';
const PW_MARK = 1347639089;	// Passwall's FWMARK 0x50535731
const PW_TAG = '# luci-app-wgclient: VPN server, removed when "Tunnel through Passwall" is turned off';
const PW_DISABLED = '# disabled by luci-app-wgclient: ';
const PW_MTU = 1280;
const UNSET = '__unset__';
const PW_GLOBAL_OPTS = [ 'enabled', 'node', 'localhost_proxy', 'client_proxy', 'use_proxy_list' ];

function pw_installed(uci) {
	return uci.get_all('passwall') != null && access('/etc/init.d/passwall') == true;
}

function pw_enabled(uci) {
	return uci.get('wgclient', 'passwall', 'enabled') == '1';
}

function first_section(uci, config, stype) {
	let sid = null;

	uci.foreach(config, stype, (s) => {
		if (!sid)
			sid = s['.name'];
	});

	return sid;
}

function pw_nodes(uci) {
	let nodes = [];

	uci.foreach('passwall', 'nodes', (s) => {
		if (s.type && s.remarks)
			push(nodes, {
				id: s['.name'],
				label: sprintf('%s: %s%s', s.type, s.protocol ? `[${s.protocol}] ` : '', s.remarks)
			});
	});

	return nodes;
}

function pw_running() {
	return length(run('nft list chain inet passwall PSW_OUTPUT_MANGLE 2>/dev/null | head -n 1') ?? '') > 0;
}

// Resolved IPs and ports of all profiles' VPN servers.
function vpn_servers(uci) {
	let ips = {}, ports = {};

	for (let id in profile_ids(uci)) {
		uci.foreach('network', `wireguard_${id}`, (s) => {
			if (!s.endpoint_host)
				return;

			ports[s.endpoint_port || '51820'] = true;

			if (iptoarr(s.endpoint_host)) {
				ips[s.endpoint_host] = true;
				return;
			}

			for (let ip in split(run(`resolveip -t 3 ${shell_quote(s.endpoint_host)}`) ?? '', '\n'))
				if (iptoarr(trim(ip)))
					ips[trim(ip)] = true;
		});
	}

	return { ips: sort(keys(ips)), ports: keys(ports) };
}

function read_lines(path) {
	const data = readfile(path);

	return data ? split(replace(data, /\n$/, ''), '\n') : [];
}

function write_lines(path, lines) {
	writefile(path, length(lines) ? join('\n', lines) + '\n' : '');
}

// Puts exactly the current VPN server IPs into Passwall's proxy list and
// comments them out of its direct list. Returns true if a file changed.
function pw_sync_rules(uci) {
	const want = pw_enabled(uci) ? vpn_servers(uci).ips : [];
	const added = as_list(uci.get('wgclient', 'passwall', 'added_ip'));
	let changed = false;

	// proxy list: drop our old entries and tag, then add what is needed
	let lines = filter(read_lines(`${PW_RULES}/proxy_ip`), (l) => l != PW_TAG && !(l in added));
	let now_added = [];

	for (let ip in want) {
		if (!(ip in lines))
			push(now_added, ip);
	}

	if (length(now_added))
		push(lines, PW_TAG, ...now_added);

	const old_proxy = readfile(`${PW_RULES}/proxy_ip`) ?? '';
	write_lines(`${PW_RULES}/proxy_ip`, lines);
	if ((readfile(`${PW_RULES}/proxy_ip`) ?? '') != old_proxy)
		changed = true;

	if (length(now_added))
		uci.set('wgclient', 'passwall', 'added_ip', now_added);
	else
		uci.delete('wgclient', 'passwall', 'added_ip');

	// direct list wins over the proxy list, so comment our servers out there
	let direct = [];

	for (let l in read_lines(`${PW_RULES}/direct_ip`)) {
		if (index(l, PW_DISABLED) == 0) {
			const ip = substr(l, length(PW_DISABLED));
			const bare = replace(ip, /\/(32|128)$/, '');

			l = (bare in want) ? l : ip;
		}
		else if (replace(trim(l), /\/(32|128)$/, '') in want) {
			l = PW_DISABLED + trim(l);
		}

		push(direct, l);
	}

	const old_direct = readfile(`${PW_RULES}/direct_ip`) ?? '';

	if (old_direct != '' || length(direct)) {
		write_lines(`${PW_RULES}/direct_ip`, direct);
		if ((readfile(`${PW_RULES}/direct_ip`) ?? '') != old_direct)
			changed = true;
	}

	return changed;
}

// Lowers a profile's MTU for the proxy overhead, remembering the original.
function pw_apply_mtu(uci, id) {
	if (uci.get('wgclient', id) == null)
		uci.set('wgclient', id, 'profile');

	const cur = uci.get('network', id, 'mtu');

	if (uci.get('wgclient', id, 'mtu_backup') == null)
		uci.set('wgclient', id, 'mtu_backup', cur ?? UNSET);

	if (cur == null || +cur > PW_MTU)
		uci.set('network', id, 'mtu', `${PW_MTU}`);
}

function pw_restore_mtu(uci, id) {
	const backup = uci.get('wgclient', id, 'mtu_backup');

	if (backup == null)
		return;

	if (backup == UNSET)
		uci.delete('network', id, 'mtu');
	else
		uci.set('network', id, 'mtu', backup);

	uci.delete('wgclient', id, 'mtu_backup');
}

function pw_restart(start) {
	system(start
		? '(/etc/init.d/passwall enable; /etc/init.d/passwall restart) >/dev/null 2>&1 &'
		: '/etc/init.d/passwall restart >/dev/null 2>&1 &');
}

function pw_turn_on(uci, node) {
	const g = first_section(uci, 'passwall', 'global');
	const fw = first_section(uci, 'passwall', 'global_forwarding');

	if (!g)
		return 'Passwall\'s configuration has no global section';

	if (!node)
		node = uci.get('passwall', g, 'node');

	if (!node || uci.get('passwall', node) != 'nodes')
		return 'Choose a Passwall node to tunnel through first';

	uci.set('wgclient', 'passwall', 'passwall');

	// save Passwall's current state, unless we already did
	if (!pw_enabled(uci)) {
		for (let opt in PW_GLOBAL_OPTS)
			uci.set('wgclient', 'passwall', `pw_${opt}`, uci.get('passwall', g, opt) ?? UNSET);

		uci.set('wgclient', 'passwall', 'pw_udp_proxy_drop_ports',
			(fw && uci.get('passwall', fw, 'udp_proxy_drop_ports')) ?? UNSET);
		uci.set('wgclient', 'passwall', 'pw_service_enabled',
			system('/etc/init.d/passwall enabled') == 0 ? '1' : '0');
	}

	uci.set('wgclient', 'passwall', 'enabled', '1');
	uci.set('passwall', g, 'enabled', '1');
	uci.set('passwall', g, 'node', node);
	uci.set('passwall', g, 'localhost_proxy', '1');	// wrap the router's own (WireGuard) traffic
	uci.set('passwall', g, 'client_proxy', '0');		// LAN traffic goes into WireGuard, not straight to the proxy
	uci.set('passwall', g, 'use_proxy_list', '1');

	// Passwall rejects UDP to some ports (QUIC); never block the VPN server's port
	const drop = fw ? uci.get('passwall', fw, 'udp_proxy_drop_ports') : null;

	if (drop && drop != 'disable') {
		const ports = vpn_servers(uci).ports;
		const keep = filter(split(drop, ','), (p) => !(trim(p) in ports));

		uci.set('passwall', fw, 'udp_proxy_drop_ports', length(keep) ? join(',', keep) : 'disable');
	}

	for (let id in profile_ids(uci))
		pw_apply_mtu(uci, id);

	pw_sync_rules(uci);

	return null;
}

function pw_turn_off(uci) {
	const g = first_section(uci, 'passwall', 'global');
	const fw = first_section(uci, 'passwall', 'global_forwarding');

	for (let opt in PW_GLOBAL_OPTS) {
		const v = uci.get('wgclient', 'passwall', `pw_${opt}`);

		if (g && v == UNSET)
			uci.delete('passwall', g, opt);
		else if (g && v != null)
			uci.set('passwall', g, opt, v);
	}

	const drop = uci.get('wgclient', 'passwall', 'pw_udp_proxy_drop_ports');

	if (fw && drop == UNSET)
		uci.delete('passwall', fw, 'udp_proxy_drop_ports');
	else if (fw && drop != null)
		uci.set('passwall', fw, 'udp_proxy_drop_ports', drop);

	const service = uci.get('wgclient', 'passwall', 'pw_service_enabled');

	uci.set('wgclient', 'passwall', 'enabled', '0');
	pw_sync_rules(uci);

	for (let id in profile_ids(uci))
		pw_restore_mtu(uci, id);

	for (let opt in [ ...PW_GLOBAL_OPTS, 'udp_proxy_drop_ports', 'service_enabled' ])
		uci.delete('wgclient', 'passwall', `pw_${opt}`);

	return service;
}

// Called after profiles changed: keeps Passwall's lists and MTUs in step.
function pw_after_profile_change(uci) {
	if (!pw_installed(uci) || !pw_enabled(uci))
		return;

	for (let id in profile_ids(uci))
		pw_apply_mtu(uci, id);

	if (pw_sync_rules(uci))
		pw_restart(false);
}

// true if the tunnel's connection carries Passwall's mark, false if it
// leaves directly, null if unknown (no connection seen, IPv6, ...)
function pw_wrapped(endpoint) {
	const m = match(endpoint ?? '', /^([0-9.]+):([0-9]+)$/);

	if (!m)
		return null;

	const ip = m[1], port = m[2];

	for (let line in split(run(`grep -F ${shell_quote(ip)} /proc/net/nf_conntrack`) ?? '', '\n')) {
		const t = match(line, /src=([^ ]+) dst=([^ ]+) sport=([0-9]+) dport=([0-9]+)/);
		const mark = match(line, /mark=([0-9]+)/);

		if (!t || !match(line, /^ipv4 +[0-9]+ udp /))
			continue;

		if (t[2] == ip && t[4] == port)
			return mark != null && +mark[1] == PW_MARK;

		// connection was opened by the server: Passwall treats our packets
		// as replies and never wraps them
		if (t[1] == ip && t[3] == port)
			return false;
	}

	return null;
}

function local_pubkey(private_key) {
	if (!match(private_key ?? '', /^[A-Za-z0-9+\/]{42}[AEIMQUYcgkosw480]=$/))
		return null;

	return trim(run(`echo ${shell_quote(private_key)} | wg pubkey`) ?? '') || null;
}

const methods = {
	status: {
		call: function() {
			const uci = cursor();
			const rt = runtime_status();
			const s = settings(uci);
			const now = time();
			const pw_on = pw_installed(uci) && pw_enabled(uci);
			let profiles = [];

			for (let id in profile_ids(uci)) {
				const cfg = load_profile(uci, id);
				const wg = rt.wg[id];
				const ifc = rt.ifaces[id];
				const peer = cfg.peers[0] ?? {};
				let handshake = 0, rx = 0, tx = 0, endpoint = null;

				for (let p in wg?.peers) {
					if (p.latest_handshake > handshake)
						handshake = p.latest_handshake;

					rx += p.rx_bytes;
					tx += p.tx_bytes;
					if (!endpoint)
						endpoint = p.endpoint;
				}

				let allowed = [];

				for (let p in cfg.peers)
					push(allowed, ...conf.collapse_default_routes(p.allowed_ips));

				push(profiles, {
					id,
					label: uci.get('wgclient', id, 'label') || substr(id, length(PREFIX)),
					auto: uci.get('network', id, 'auto') != '0',
					up: !!ifc?.up,
					pending: !!ifc?.pending,
					error: ifc?.errors?.[0]?.code,
					uptime: ifc?.uptime,
					addresses: cfg.iface.addresses,
					dns: cfg.iface.dns,
					endpoint: endpoint ?? (peer.endpoint_host
						? ((index(peer.endpoint_host, ':') >= 0) ? `[${peer.endpoint_host}]` : peer.endpoint_host) + `:${peer.endpoint_port ?? 51820}`
						: null),
					allowed_ips: allowed,
					full_tunnel: conf.is_full_tunnel(allowed),
					peer_count: length(cfg.peers),
					public_key: wg?.public_key ?? local_pubkey(cfg.iface.private_key),
					latest_handshake: handshake,
					handshake_age: handshake ? now - handshake : null,
					rx_bytes: rx,
					tx_bytes: tx,
					proxied: (pw_on && ifc?.up) ? pw_wrapped(endpoint) : null
				});
			}

			return {
				settings: s,
				lan_zone_ok: zone_exists(uci, s.lan_zone),
				wan_zone_ok: zone_exists(uci, s.wan_zone),
				killswitch_active: s.killswitch && uci.get('firewall', KS_SID, 'enabled') == '1',
				proxy_apps: detect_proxy_apps(uci),
				passwall: {
					installed: pw_installed(uci),
					enabled: pw_on,
					running: pw_installed(uci) ? pw_running() : false,
					node: pw_installed(uci) ? uci.get('passwall', first_section(uci, 'passwall', 'global') ?? '', 'node') : null,
					nodes: pw_installed(uci) ? pw_nodes(uci) : []
				},
				profiles
			};
		}
	},

	// Validates a configuration and returns a summary, without saving.
	parse: {
		args: { conf: '' },
		call: function(req) {
			const r = conf.parse(req.args.conf);

			if (r.error)
				return { error: r.error };

			let allowed = [];

			for (let p in r.peers)
				push(allowed, ...p.allowed_ips);

			return {
				addresses: r.iface.addresses,
				dns: r.iface.dns,
				endpoint: r.peers[0].endpoint_host
					? `${r.peers[0].endpoint_host}:${r.peers[0].endpoint_port}` : null,
				peer_count: length(r.peers),
				allowed_ips: allowed,
				full_tunnel: conf.is_full_tunnel(allowed),
				warnings: r.warnings
			};
		}
	},

	get: {
		args: { id: '' },
		call: function(req) {
			const uci = cursor();
			const id = req.args.id;

			if (!is_profile(uci, id))
				return { error: 'No such profile' };

			const cfg = load_profile(uci, id);
			const mtu_backup = uci.get('wgclient', id, 'mtu_backup');

			// show the profile's own MTU, not the one lowered for Passwall
			if (mtu_backup != null)
				cfg.iface.mtu = (mtu_backup == UNSET) ? null : +mtu_backup;

			return {
				id,
				label: uci.get('wgclient', id, 'label') || substr(id, length(PREFIX)),
				conf: conf.serialize(cfg)
			};
		}
	},

	// Creates (no id) or replaces (id given) a profile from .conf text.
	save: {
		args: { id: '', label: '', conf: '', connect: false },
		call: function(req) {
			const uci = cursor();
			const label = trim(req.args.label ?? '');
			const r = conf.parse(req.args.conf);

			if (r.error)
				return { error: r.error };

			if (!length(label) || length(label) > 64)
				return { error: 'Please enter a name of 1 to 64 characters' };

			let id = req.args.id;
			let auto = false;

			if (length(id)) {
				if (!is_profile(uci, id))
					return { error: 'No such profile' };

				auto = uci.get('network', id, 'auto') != '0';
			}
			else {
				id = slugify(uci, label);
			}

			const connect_now = req.args.connect || auto;

			if (req.args.connect) {
				for (let other in profile_ids(uci))
					if (other != id)
						uci.set('network', other, 'auto', '0');
			}

			write_profile(uci, id, r, connect_now);
			sync_routing(uci);

			if (uci.get('wgclient', 'settings') == null)
				uci.set('wgclient', 'settings', 'settings');

			uci.set('wgclient', id, 'profile');
			uci.set('wgclient', id, 'label', label);
			uci.delete('wgclient', id, 'mtu_backup');	// the new .conf defines the MTU
			pw_after_profile_change(uci);
			uci.save('wgclient');

			sync_firewall(uci);
			apply(uci, [ 'wgclient', 'network', 'firewall', 'passwall' ]);

			if (connect_now)
				iface_up(id);

			return { id, warnings: r.warnings };
		}
	},

	remove: {
		args: { id: '' },
		call: function(req) {
			const uci = cursor();
			const id = req.args.id;

			if (!is_profile(uci, id))
				return { error: 'No such profile' };

			iface_down(id);

			let peers = [];

			uci.foreach('network', `wireguard_${id}`, (s) => push(peers, s['.name']));

			for (let sid in peers)
				uci.delete('network', sid);

			uci.delete('network', id);
			sync_routing(uci);
			uci.delete('wgclient', id);
			pw_after_profile_change(uci);
			uci.save('wgclient');

			sync_firewall(uci);
			apply(uci, [ 'wgclient', 'network', 'firewall', 'passwall' ]);

			return { result: true };
		}
	},

	// Connects a profile and disconnects all other profiles.
	connect: {
		args: { id: '' },
		call: function(req) {
			const uci = cursor();
			const id = req.args.id;

			if (!is_profile(uci, id))
				return { error: 'No such profile' };

			for (let other in profile_ids(uci)) {
				if (other != id) {
					uci.set('network', other, 'auto', '0');
					iface_down(other);
				}
			}

			uci.set('network', id, 'auto', '1');
			sync_routing(uci);
			apply(uci, [ 'network' ]);
			iface_up(id);

			return { result: true };
		}
	},

	disconnect: {
		args: { id: '' },
		call: function(req) {
			const uci = cursor();
			const id = req.args.id;

			if (!is_profile(uci, id))
				return { error: 'No such profile' };

			uci.set('network', id, 'auto', '0');
			uci.save('network');
			apply(uci, [ 'network' ]);
			iface_down(id);

			return { result: true };
		}
	},

	// Turns "Tunnel through Passwall" on (optionally with a node) or off.
	set_passwall: {
		args: { enabled: false, node: '' },
		call: function(req) {
			const uci = cursor();

			if (!pw_installed(uci))
				return { error: 'Passwall is not installed' };

			let start_service = true;

			if (req.args.enabled) {
				const err = pw_turn_on(uci, req.args.node);

				if (err)
					return { error: err };
			}
			else if (pw_enabled(uci)) {
				start_service = false;

				if (pw_turn_off(uci) == '0')
					system('/etc/init.d/passwall disable >/dev/null 2>&1');
			}
			else {
				return { result: true };
			}

			uci.save('wgclient');
			uci.save('passwall');
			uci.save('network');
			apply(uci, [ 'wgclient', 'passwall', 'network' ]);
			pw_restart(start_service);

			return { result: true, enabled: !!req.args.enabled };
		}
	},

	set_killswitch: {
		args: { enabled: false },
		call: function(req) {
			const uci = cursor();
			const s = settings(uci);

			if (req.args.enabled && (!zone_exists(uci, s.lan_zone) || !zone_exists(uci, s.wan_zone)))
				return { error: `Firewall zones "${s.lan_zone}" and "${s.wan_zone}" are required for the kill switch` };

			if (uci.get('wgclient', 'settings') == null)
				uci.set('wgclient', 'settings', 'settings');

			uci.set('wgclient', 'settings', 'killswitch', req.args.enabled ? '1' : '0');
			uci.save('wgclient');

			sync_firewall(uci);
			apply(uci, [ 'wgclient', 'firewall' ]);

			return { result: true, killswitch: !!req.args.enabled };
		}
	}
};

return { 'luci.wgclient': methods };

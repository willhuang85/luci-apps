#!/bin/sh /etc/rc.common
# Runs the relay that carries WireGuard through Passwall's SOCKS port while
# "Carry the VPN through Passwall" is on, see /usr/libexec/wgpasswall-relay.

START=99
USE_PROCD=1

start_service() {
	rm -f /var/run/wgpasswall/relay-status.json
	[ "$(uci -q get wgpasswall.settings.via_passwall)" = 1 ] || return 0
	uci -q show network | grep -q '\.wgpasswall_orig_host=' || return 0

	procd_open_instance relay
	procd_set_param command /usr/bin/ucode /usr/libexec/wgpasswall-relay
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

# the relay rewrites its status file every 2 seconds; do not leave a stale
# one behind when it stops (e.g. when the VPN no longer goes through Passwall)
stop_service() {
	rm -f /var/run/wgpasswall/relay-status.json
}

service_triggers() {
	procd_add_reload_trigger wgpasswall
}

#!/usr/bin/ucode
// SPDX-License-Identifier: Apache-2.0
//
// UDP relay that carries WireGuard through a local SOCKS5 proxy, used for
// "Carry the VPN through Passwall": each tunnel's endpoint points at
// 127.0.0.1:<listen>, and every datagram is forwarded with SOCKS5 UDP
// ASSOCIATE to the proxy (Passwall's node SOCKS port), which sends it to
// the real VPN server over the proxy connection.
//
// This avoids transparent interception of WireGuard's own packets, which
// conntrack does not handle: replies injected by the proxy become new
// "server opened" connections, after which the proxy treats WireGuard's
// packets as replies and lets them out directly.
//
// The relays are read from /etc/config/network: every WireGuard peer with
// "wgpasswall_orig_host" set (by the app, while that is on) is relayed from
// 127.0.0.1:<endpoint_port> to its original endpoint. The SOCKS port is
// Passwall's "node_socks_port". For tests, WGPASSWALL_RELAY_CONFIG can point
// to a JSON file instead:
//   { "socks": { "host": "127.0.0.1", "port": 1070 },
//     "relays": [ { "listen": 51821, "host": "vpn.example.com", "port": 51820 } ] }
// Status: /var/run/wgpasswall/relay-status.json
//
// Watchdog: the association to the local SOCKS port can stay open while the
// proxy's own connection to its server is dead (seen with Xray: it keeps the
// UDP session of a sender, kept busy by WireGuard's keepalives, on the dead
// upstream). So when WireGuard has been sending through a relay for
// SENDING_MIN seconds but has not completed a handshake for HANDSHAKE_MAX
// seconds, the relay drops the association and opens a new one from a new
// local port, so the proxy builds a fresh session. WireGuard renews its
// handshake every 2 minutes while traffic flows (keepalives included) and
// retries every 5 seconds when it gets no answer; SENDING_MIN gives it time
// for that after an idle spell, when the last handshake is old anyway. An
// idle tunnel sends nothing and is left alone.
//
// Fresh associations do not help when Passwall's own client is stuck on its
// node (seen with an Xray hysteria node after the server side was paused and
// resumed: nothing got through until Passwall restarted). So after
// PW_CHECK_AFTER reconnects in a row without a handshake, the relay checks
// the node itself by fetching a small page through the SOCKS port (in a
// child process, "probe", so relaying goes on). If the node answers, the VPN
// server is what does not (down?) and Passwall is left alone; if not,
// Passwall is restarted, under the lock of the luci-apps, at most once every
// PW_RESTART_GAP seconds. For tests, WGPASSWALL_RELAY_WG_DUMP can name a
// file to read instead of `wg show all dump`, and the WGPASSWALL_RELAY_*
// settings below can be changed.

'use strict';

import * as socket from 'socket';
import * as uloop from 'uloop';
import { readfile, writefile, rename, mkdir, popen } from 'fs';
import { cursor } from 'uci';

const STATUS = getenv('WGPASSWALL_RELAY_STATUS') ?? '/var/run/wgpasswall/relay-status.json';
const RETRY_MS = 3000;
const CHECK_MS = +(getenv('WGPASSWALL_RELAY_CHECK_MS') ?? 10000);
const GRACE = +(getenv('WGPASSWALL_RELAY_GRACE') ?? 30);		// s after (re)connecting
const HANDSHAKE_MAX = +(getenv('WGPASSWALL_RELAY_HANDSHAKE_MAX') ?? 180);
const RECENT_TX = +(getenv('WGPASSWALL_RELAY_RECENT_TX') ?? 15);	// s
const SENDING_MIN = +(getenv('WGPASSWALL_RELAY_SENDING_MIN') ?? 20);	// s
const PW_CHECK_AFTER = +(getenv('WGPASSWALL_RELAY_PW_CHECK_AFTER') ?? 3);	// reconnects
const PROBE_GAP = +(getenv('WGPASSWALL_RELAY_PROBE_GAP') ?? 120);	// s between checks
const PW_RESTART_GAP = +(getenv('WGPASSWALL_RELAY_PW_RESTART_GAP') ?? 600);	// s
const PW_RESTART = getenv('WGPASSWALL_RELAY_PW_RESTART') ??
	'(mkdir -p /var/lock; exec 9>/var/lock/luci-apps.lock; flock 9; /etc/init.d/passwall restart 9>&-; true) </dev/null >/dev/null 2>&1 &';
const PROBE_HOST = getenv('WGPASSWALL_RELAY_PROBE_HOST') ?? 'connectivitycheck.gstatic.com';
const PROBE_TIMEOUT = 10;	// s

function load_config() {
	if (getenv('WGPASSWALL_RELAY_CONFIG'))
		return json(readfile(getenv('WGPASSWALL_RELAY_CONFIG')) ?? 'null');

	const uci = cursor();
	let relays = [], socks_port = 1070;

	uci.foreach('passwall', 'global', (s) => {
		socks_port = +(s.node_socks_port || 1070);
	});

	uci.foreach('network', null, (s) => {
		if (index(s['.type'], 'wireguard_wgc_') == 0 && s.wgpasswall_orig_host && s.endpoint_port)
			push(relays, { listen: +s.endpoint_port, host: s.wgpasswall_orig_host, port: +(s.wgpasswall_orig_port || 51820) });
	});

	return { socks: { host: '127.0.0.1', port: socks_port }, relays };
}

const cfg = load_config();

if (!cfg || !length(cfg.relays)) {
	warn('wgpasswall-relay: no tunnels to relay\n');
	exit(0);
}

mkdir(replace(STATUS, /\/[^\/]+$/, ''));

uloop.init();

const socks_host = cfg.socks?.host ?? '127.0.0.1';
const socks_port = +(cfg.socks?.port ?? 1070);

function u16(n) {
	return chr((n >> 8) & 255, n & 255);
}

// SOCKS5 address field (ATYP + address + port) for a destination
function socks_addr(host, port) {
	const ip = iptoarr(host);

	if (ip && length(ip) == 4)
		return chr(1, ...ip) + u16(port);

	if (ip && length(ip) == 16)
		return chr(4, ...ip) + u16(port);

	return chr(3, length(host)) + host + u16(port);
}

// length of the address field at offset `off` of a SOCKS5 reply/header
function socks_addr_len(data, off) {
	switch (ord(data, off)) {
	case 1: return 1 + 4 + 2;
	case 4: return 1 + 16 + 2;
	case 3: return 1 + 1 + ord(data, off + 1) + 2;
	}

	return null;
}

function recv_exact(sock, n) {
	let buf = '';

	while (length(buf) < n) {
		const chunk = sock.recv(n - length(buf));

		if (!length(chunk))
			return null;

		buf += chunk;
	}

	return buf;
}

// Fetches a small page through the proxy (SOCKS5 CONNECT to PROBE_HOST:80):
// true if the node answers.
function probe_node() {
	const s = socket.create(socket.AF_INET, socket.SOCK_STREAM);
	const timeout = { sec: PROBE_TIMEOUT, usec: 0 };

	if (!s)
		return false;

	s.setopt(socket.SOL_SOCKET, socket.SO_RCVTIMEO, timeout);
	s.setopt(socket.SOL_SOCKET, socket.SO_SNDTIMEO, timeout);

	if (!s.connect(socks_host, socks_port))
		return false;

	s.send(chr(5, 1, 0));

	const greet = recv_exact(s, 2);

	if (!greet || ord(greet, 1) != 0)
		return false;

	s.send(chr(5, 1, 0) + socks_addr(PROBE_HOST, 80));

	const head = recv_exact(s, 4);

	if (!head || ord(head, 1) != 0)
		return false;

	const atyp = ord(head, 3);

	if (!recv_exact(s, (atyp == 1) ? 6 : (atyp == 4) ? 18 : ord(recv_exact(s, 1) ?? '\0') + 2))
		return false;

	s.send(`GET /generate_204 HTTP/1.0\r\nHost: ${PROBE_HOST}\r\nConnection: close\r\n\r\n`);

	const reply = s.recv(64);

	s.close();

	return match(reply ?? '', /^HTTP\/1\.[01] [0-9]{3}/) != null;
}

// "wgpasswall-relay probe": only the check of the node, as exit code
if (ARGV[0] == 'probe')
	exit(probe_node() ? 0 : 1);

// Opens the TCP control connection and requests a UDP association.
// Returns { ctrl, relay } or { error }.
function associate() {
	const ctrl = socket.create(socket.AF_INET, socket.SOCK_STREAM);

	if (!ctrl)
		return { error: 'cannot create socket' };

	ctrl.setopt(socket.SOL_SOCKET, socket.SO_RCVTIMEO, { sec: 5, usec: 0 });
	ctrl.setopt(socket.SOL_SOCKET, socket.SO_SNDTIMEO, { sec: 5, usec: 0 });

	if (!ctrl.connect(socks_host, socks_port)) {
		ctrl.close();
		return { error: `SOCKS proxy ${socks_host}:${socks_port} not reachable (is Passwall running?)` };
	}

	ctrl.send(chr(5, 1, 0));

	const greet = recv_exact(ctrl, 2);

	if (!greet || ord(greet, 0) != 5 || ord(greet, 1) != 0) {
		ctrl.close();
		return { error: 'SOCKS proxy refused the handshake' };
	}

	ctrl.send(chr(5, 3, 0) + socks_addr('0.0.0.0', 0));

	const head = recv_exact(ctrl, 4);

	if (!head || ord(head, 1) != 0) {
		ctrl.close();
		return { error: 'SOCKS proxy refused UDP (does the node support UDP?)' };
	}

	const rest = recv_exact(ctrl, ord(head, 3) == 1 ? 6 : ord(head, 3) == 4 ? 18 : 0);

	if (!rest || ord(head, 3) == 3) {
		ctrl.close();
		return { error: 'unexpected SOCKS reply' };
	}

	let addr, port;

	if (ord(head, 3) == 1) {
		addr = arrtoip([ ord(rest, 0), ord(rest, 1), ord(rest, 2), ord(rest, 3) ]);
		port = (ord(rest, 4) << 8) | ord(rest, 5);
	}
	else {
		let a = [];
		for (let i = 0; i < 16; i++)
			push(a, ord(rest, i));
		addr = arrtoip(a);
		port = (ord(rest, 16) << 8) | ord(rest, 17);
	}

	// "any" address means: same host as the TCP connection
	if (addr == '0.0.0.0' || addr == '::')
		addr = socks_host;

	ctrl.setopt(socket.SOL_SOCKET, socket.SO_RCVTIMEO, { sec: 0, usec: 0 });

	return { ctrl, relay: { address: addr, port } };
}

let relays = [];
let connect_relay;	// defined below, needed by the retry timer

function set_down(r, error) {
	if (r.ctrl_handle) r.ctrl_handle.delete();
	if (r.ctrl) r.ctrl.close();
	if (r.out_handle) r.out_handle.delete();
	if (r.out) r.out.close();

	r.ctrl = r.ctrl_handle = r.relay = r.out = r.out_handle = null;
	r.up = false;
	r.error = error;

	if (!r.retry)
		r.retry = uloop.timer(RETRY_MS, () => { r.retry = null; connect_relay(r); });
}

// proxy -> WireGuard
function open_out(r) {
	r.out = socket.create(socket.AF_INET, socket.SOCK_DGRAM);

	if (!r.out || !r.out.bind({ address: '127.0.0.1', port: 0 }))
		return false;

	r.out_handle = uloop.handle(r.out, () => {
		const d = r.out.recv(65535);

		if (length(d) < 4 || !r.client)
			return;

		const alen = socks_addr_len(d, 3);

		if (alen == null || length(d) <= 3 + alen)
			return;

		const payload = substr(d, 3 + alen);

		if (r.local.send(payload, 0, r.client) != null)
			r.rx += length(payload);
	}, uloop.ULOOP_READ);

	return true;
}

connect_relay = function(r) {
	const a = associate();

	if (a.error)
		return set_down(r, a.error);

	// a new local port for every association: the proxy keys its UDP
	// sessions by the sender, so this gets a fresh session upstream
	if (!open_out(r)) {
		a.ctrl.close();
		return set_down(r, 'cannot create socket');
	}

	r.ctrl = a.ctrl;
	r.relay = a.relay;
	r.up = true;
	r.error = null;
	r.since = time();

	// the association lives as long as the TCP connection
	r.ctrl_handle = uloop.handle(r.ctrl, () => {
		const d = r.ctrl.recv(512);

		if (!length(d))
			set_down(r, 'SOCKS proxy closed the association');
	}, uloop.ULOOP_READ);
};

for (let c in cfg.relays) {
	const r = {
		listen: +c.listen, host: c.host, port: +c.port,
		header: chr(0, 0, 0) + socks_addr(c.host, +c.port),
		client: null, up: false, error: 'starting', rx: 0, tx: 0
	};

	r.local = socket.create(socket.AF_INET, socket.SOCK_DGRAM);

	if (!r.local || !r.local.bind({ address: '127.0.0.1', port: r.listen })) {
		warn(`wgpasswall-relay: cannot listen on 127.0.0.1:${r.listen}\n`);
		exit(1);
	}

	// WireGuard -> proxy
	r.local_handle = uloop.handle(r.local, () => {
		const from = {};
		const d = r.local.recv(65535, 0, from);

		if (!length(d))
			return;

		r.client = { address: from.address, port: from.port };

		if (r.up && r.out.send(r.header + d, 0, r.relay) != null) {
			const now = time();

			// start of the current stretch of sending
			if (!r.last_tx || now - r.last_tx > RECENT_TX)
				r.sending_since = now;

			r.tx += length(d);
			r.last_tx = now;
		}
	}, uloop.ULOOP_READ);

	push(relays, r);
}

// Latest WireGuard handshake per relay port: { <listen port>: <unix time> },
// from the peers whose endpoint is 127.0.0.1:<port>.
function handshakes() {
	let out = {}, text;

	if (getenv('WGPASSWALL_RELAY_WG_DUMP'))
		text = readfile(getenv('WGPASSWALL_RELAY_WG_DUMP'));
	else {
		// AmneziaWG tunnels too (their peer lines look the same)
		const p = popen('wg show all dump 2>/dev/null; awg show all dump 2>/dev/null', 'r');

		text = p ? p.read('all') : null;
		p?.close();
	}

	// peer lines: iface, pubkey, psk, endpoint, allowed ips, handshake, rx, tx, keepalive
	for (let line in split(text ?? '', '\n')) {
		const f = split(line, '\t');
		const m = (length(f) == 9) ? match(f[3], /^127\.0\.0\.1:([0-9]+)$/) : null;

		if (m)
			out[m[1]] = +f[5];
	}

	return out;
}

let probing = false, last_probe = 0, last_pw_restart = 0;

// Checks the node in a child process; restarts Passwall if it does not
// answer either.
function check_node(r) {
	probing = true;
	last_probe = time();

	uloop.process(getenv('WGPASSWALL_RELAY_UCODE') ?? '/usr/bin/ucode', [ sourcepath(), 'probe' ], getenv(), (code) => {
		probing = false;

		if (code == 0) {
			warn(`wgpasswall-relay: Passwall's node answers, but ${r.host}:${r.port} does not through it; leaving Passwall alone\n`);
			return;
		}

		last_pw_restart = time();
		warn(`wgpasswall-relay: Passwall's node does not answer either; restarting Passwall\n`);
		system(PW_RESTART);
	});
}

function watchdog() {
	const now = time();
	let hs = null;

	for (let r in relays) {
		if (!r.up || now - r.since < GRACE || !r.last_tx || now - r.last_tx > RECENT_TX ||
		    now - r.sending_since < SENDING_MIN)
			continue;

		hs ??= handshakes();

		const last = hs[`${r.listen}`];

		// unknown peer (not WireGuard's endpoint?): nothing to judge by
		if (last == null)
			continue;

		if (now - last > HANDSHAKE_MAX) {
			warn(`wgpasswall-relay: no handshake through the proxy for ${r.host}:${r.port} since ${last ? now - last + 's' : 'start'}; reconnecting\n`);
			r.resets = (r.resets ?? 0) + 1;
			r.dead_resets = (r.dead_resets ?? 0) + 1;
			set_down(r, 'no answer from the VPN server through the proxy; reconnecting');

			if (r.dead_resets >= PW_CHECK_AFTER && !probing && now - last_probe >= PROBE_GAP &&
			    now - last_pw_restart >= PW_RESTART_GAP)
				check_node(r);
		}
		else {
			r.dead_resets = 0;
		}
	}
}

function write_status() {
	let st = [];

	for (let r in relays)
		push(st, {
			listen: r.listen, host: r.host, port: r.port, up: r.up,
			error: r.error, since: r.since, rx_bytes: r.rx, tx_bytes: r.tx, resets: r.resets ?? 0
		});

	writefile(STATUS + '.tmp', sprintf('%J', { updated: time(), relays: st }));
	rename(STATUS + '.tmp', STATUS);
}

for (let r in relays)
	connect_relay(r);

write_status();

let status_timer;
status_timer = uloop.timer(2000, function() {
	write_status();
	status_timer.set(2000);
});

let watchdog_timer;
watchdog_timer = uloop.timer(CHECK_MS, function() {
	watchdog();
	watchdog_timer.set(CHECK_MS);
});

uloop.run();

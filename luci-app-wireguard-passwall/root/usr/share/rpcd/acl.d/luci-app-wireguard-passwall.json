{
	"luci-app-wireguard-passwall": {
		"description": "Grant access to the WireGuard VPN client",
		"read": {
			"ubus": {
				"luci.wgpasswall": [ "status", "parse", "relay_log" ]
			}
		},
		"write": {
			"ubus": {
				"luci.wgpasswall": [ "get", "save", "remove", "connect", "disconnect", "set_options", "set_ports", "reapply" ]
			}
		}
	}
}

// SPDX-License-Identifier: Apache-2.0
//
// rpcd backend for luci-app-wireguard-passwall.
//
// Every imported profile is a regular netifd "wireguard" interface named
// "wgc_<slug>" in /etc/config/network, with its peers stored in
// "wireguard_wgc_<slug>" sections. All profiles share the firewall zone
// "wgpasswall"; one profile at a time is connected.
//
// Networks decide what goes where. Every wired port and Wi-Fi network (SSID)
// belongs to one network:
//
//  - the LAN ("lan"): out directly
//  - the VPN network ("wgvpn", bridge br-wgvpn): through the VPN tunnel;
//    with "via_passwall" the tunnel itself goes through Passwall
//  - the Passwall network ("wgproxy", bridge br-wgproxy): through Passwall
//  - other zones, e.g. a guest network: out directly, never VPN or Passwall
//
// The app creates the VPN and Passwall networks (bridge, subnet, DHCP,
// firewall zone) and assigns wired ports; Wi-Fi Setup assigns the Wi-Fi
// networks. Everything below matches by network (interface), so no rule
// depends on another one's order.
//
// Routing is policy based (like wg-quick): the tunnel's routes live in their
// own table (default 51820); "lookup main suppress_prefixlength 0" keeps
// LAN and other specific routes; traffic coming in from the VPN network, and
// the router's own traffic unless the tunnel goes through Passwall, is sent
// to the VPN table when it carries no mark bit of bypass_mask (proxy cores
// such as Xray mark their own sockets with 255, WireGuard its packets with
// fwmark 0xca6c, so those leave via the WAN).
//
// "via_passwall" points each tunnel's endpoint at a local relay
// (/usr/libexec/wgpasswall-relay) that forwards WireGuard's packets through
// Passwall's SOCKS port to the real server.
//
// The kill switch rejects traffic from the VPN network to the WAN, so its
// devices can only reach the internet through the tunnel. Devices on the VPN
// network get the profile's DNS server through the tunnel (vpn_dns_nft) and
// no IPv6 internet access while the profile only carries IPv4
// (ipv6_outside_vpn); both follow the configured connection, so they apply
// while a profile is set to connected, even if its tunnel is down.
//
// Passwall runs while something needs it (pw_needed): devices on the
// Passwall network, or the tunnel going through it. The app then controls
// the few Passwall options that depend on that (PW_MANAGED) and adds a
// "Proxy" access control rule per network Passwall carries; everything else,
// the node included, stays Passwall's own. The original options are saved
// and restored once nothing needs Passwall anymore.

'use strict';

import { access, mkdir, popen, readfile, unlink, writefile } from 'fs';
import { connect } from 'ubus';
import { cursor } from 'uci';
import * as conf from 'wgpasswall.conf';

// raised when status changes in a way older pages cannot show
const API_VERSION = 2;
const PREFIX = 'wgc_';
const ZONE = 'wgpasswall';
const ZONE_SID = 'wgpasswall_zone';
const FWD_SID = 'wgpasswall_fwd';
const KS_SID = 'wgpasswall_killswitch';
const NO_V6_SID = 'wgpasswall_no_ipv6';

// The networks the app owns (ensure_networks); subnets are picked from
// 192.168.<start>.0/24 upwards.
const NETS = {
	vpn: { net: 'wgvpn', bridge: 'br-wgvpn', dev_sid: 'wgpasswall_vpn_dev', zone: 'wgvpn', zone_sid: 'wgpasswall_vpn_zone', start: 20 },
	proxy: { net: 'wgproxy', bridge: 'br-wgproxy', dev_sid: 'wgpasswall_proxy_dev', zone: 'wgproxy', zone_sid: 'wgpasswall_proxy_zone', start: 30 }
};

// Forwardings of their zones: [ sid, src, dest ], with 'lan' / 'wan' standing
// for the configured LAN / WAN zones. Both may reach the LAN and the LAN may
// reach them (separate subnets, so no discovery across them).
const NET_FWDS = {
	vpn: [ [ FWD_SID, 'wgvpn', ZONE ], [ 'wgpasswall_vpn_wan', 'wgvpn', 'wan' ],
	       [ 'wgpasswall_vpn_lan', 'wgvpn', 'lan' ], [ 'wgpasswall_lan_vpn', 'lan', 'wgvpn' ] ],
	proxy: [ [ 'wgpasswall_proxy_wan', 'wgproxy', 'wan' ],
	         [ 'wgpasswall_proxy_lan', 'wgproxy', 'lan' ], [ 'wgpasswall_lan_proxy', 'lan', 'wgproxy' ] ]
};

// Passwall: a "Proxy" access control rule per network it carries, matched
// by interface. Passwall applies its rules in the alphabetical order of their
// section names and skips names containing "default"; the networks never
// overlap, so the order does not matter.
const PW_NET_ACL_PREFIX = '0wgpasswall_net_';
// rules and sections of earlier versions (per device / per LAN), removed
const OLD_ACL_SIDS = [ 'wgpasswall_vpn_devices', '0wgpasswall_vpn_devices' ];
const OLD_ACL_PREFIXES = [ 'wgpasswall_lan_', 'zzz_wgpasswall_lan_', '0wgpasswall_direct_' ];
const OLD_MARK_SID = 'wgpasswall_devices';

// DNS of the VPN network's devices: an nftables table of its own, loaded by
// fw4 through an include, ahead of Passwall's DNS redirect
const DNS_SID = 'wgpasswall_devices_dns';
const DNS_NFT = getenv('WGPASSWALL_DNS_NFT') ?? '/etc/wgpasswall/devices-dns.nft';
const DNS_TABLE = 'wgpasswall_dns';

const RULE_SIDS = {
	rule: [ 'wgpasswall_rule_main', 'wgpasswall_rule_vpn' ],
	rule6: [ 'wgpasswall_rule6_main', 'wgpasswall_rule6_vpn' ]
};

// uci config of known transparent proxy apps
const PROXY_APPS = {
	passwall: 'Passwall', passwall2: 'Passwall 2', homeproxy: 'HomeProxy', openclash: 'OpenClash'
};

// Keep the connection outside of the handlers to prevent premature GC.
const ubus = connect();

function shell_quote(s) {
	return "'" + replace(`${s}`, "'", "'\\''") + "'";
}

function run(cmd) {
	const p = popen(`${cmd} 2>/dev/null`, 'r');

	if (!p)
		return null;

	const out = p.read('all');
	p.close();

	return out;
}

function as_list(v) {
	if (v == null)
		return [];

	return (type(v) == 'array') ? v : [ v ];
}

function opt_uint(uci, name, def, min, max) {
	const v = uci.get('wgpasswall', 'settings', name);
	const n = match(v ?? '', /^(0x[0-9a-fA-F]+|[0-9]+)$/) ? int(v, index(v, '0x') == 0 ? 16 : 10) : null;

	return (n != null && n >= min && n <= max) ? n : def;
}

function settings(uci) {
	let table = opt_uint(uci, 'route_table', 51820, 1, 0x7fffffff);

	// never hijack the reserved local/main/default tables
	if (table >= 253 && table <= 255)
		table = 51820;

	return {
		killswitch: uci.get('wgpasswall', 'settings', 'killswitch') == '1',
		via_passwall: uci.get('wgpasswall', 'settings', 'via_passwall') == '1',
		lan_zone: uci.get('wgpasswall', 'settings', 'lan_zone') || 'lan',
		wan_zone: uci.get('wgpasswall', 'settings', 'wan_zone') || 'wan',
		route_table: table,
		rule_priority: opt_uint(uci, 'rule_priority', 30100, 1000, 32000),
		bypass_mask: opt_uint(uci, 'bypass_mask', 0xff, 1, 0xffffffff),
		wg_fwmark: opt_uint(uci, 'wg_fwmark', 0xca6c, 1, 0xffffffff)
	};
}

function ensure_settings(uci) {
	if (uci.get('wgpasswall', 'settings') == null)
		uci.set('wgpasswall', 'settings', 'settings');
}

function pw_installed(uci) {
	return uci.get_all('passwall') != null && access('/etc/init.d/passwall') == true;
}

// true while the tunnel goes through Passwall (needs Passwall installed)
function via_passwall(uci) {
	return settings(uci).via_passwall && pw_installed(uci);
}

function detect_proxy_apps(uci) {
	let found = [];

	for (let cfg, name in PROXY_APPS)
		if (uci.get_all(cfg) != null)
			push(found, name);

	return found;
}

function profile_ids(uci) {
	let ids = [];

	uci.foreach('network', 'interface', (s) => {
		if (index(s['.name'], PREFIX) == 0 && s.proto == 'wireguard')
			push(ids, s['.name']);
	});

	return ids;
}

function is_profile(uci, id) {
	return type(id) == 'string' && index(id, PREFIX) == 0 &&
		uci.get('network', id) == 'interface' &&
		uci.get('network', id, 'proto') == 'wireguard';
}

function slugify(uci, label) {
	let slug = substr(replace(lc(label ?? ''), /[^a-z0-9]/g, ''), 0, 11);

	if (!length(slug))
		slug = 'vpn';

	let id = PREFIX + slug;

	// interface names double as Linux device names: max. 15 characters
	for (let n = 2; uci.get('network', id) != null; n++)
		id = PREFIX + substr(slug, 0, 11 - length(`${n}`)) + n;

	return id;
}

function zone_exists(uci, name) {
	let found = false;

	uci.foreach('firewall', 'zone', (s) => {
		if (s.name == name)
			found = true;
	});

	return found;
}

// Reads a profile back from uci into the structure used by conf.uc.
function load_profile(uci, id) {
	let peers = [];

	uci.foreach('network', `wireguard_${id}`, (s) => {
		push(peers, {
			public_key: s.public_key,
			preshared_key: s.preshared_key,
			// while relayed, the real server is kept in wgpasswall_orig_*
			endpoint_host: s.wgpasswall_orig_host ?? s.endpoint_host,
			endpoint_port: (s.wgpasswall_orig_host ? s.wgpasswall_orig_port : s.endpoint_port)
				? +(s.wgpasswall_orig_host ? s.wgpasswall_orig_port : s.endpoint_port) : null,
			allowed_ips: as_list(s.allowed_ips),
			persistent_keepalive: s.persistent_keepalive ? +s.persistent_keepalive : null
		});
	});

	return {
		iface: {
			private_key: uci.get('network', id, 'private_key'),
			addresses: as_list(uci.get('network', id, 'addresses')),
			// kept off the interface, in wgpasswall.<profile>.dns (see sync_dns)
			dns: as_list(uci.get('network', id, 'dns') ?? uci.get('wgpasswall', id, 'dns')),
			dns_search: as_list(uci.get('network', id, 'dns_search')),
			mtu: uci.get('network', id, 'mtu') ? +uci.get('network', id, 'mtu') : null,
			listen_port: uci.get('network', id, 'listen_port') ? +uci.get('network', id, 'listen_port') : null
		},
		peers
	};
}

function write_profile(uci, id, cfg, auto) {
	let old_peers = [];

	uci.foreach('network', `wireguard_${id}`, (s) => push(old_peers, s['.name']));

	for (let sid in old_peers)
		uci.delete('network', sid);

	// clear the options in place to keep the section's position (= list order)
	if (uci.get('network', id) == 'interface') {
		for (let opt in keys(uci.get_all('network', id)))
			if (index(opt, '.') != 0)
				uci.delete('network', id, opt);
	}
	else {
		uci.set('network', id, 'interface');
	}

	uci.set('network', id, 'proto', 'wireguard');
	uci.set('network', id, 'private_key', cfg.iface.private_key);
	uci.set('network', id, 'addresses', cfg.iface.addresses);
	uci.set('network', id, 'auto', auto ? '1' : '0');

	if (length(cfg.iface.dns))
		uci.set('network', id, 'dns', cfg.iface.dns);

	if (length(cfg.iface.dns_search))
		uci.set('network', id, 'dns_search', cfg.iface.dns_search);

	if (cfg.iface.mtu)
		uci.set('network', id, 'mtu', `${cfg.iface.mtu}`);

	if (cfg.iface.listen_port)
		uci.set('network', id, 'listen_port', `${cfg.iface.listen_port}`);

	for (let p in cfg.peers) {
		const sid = uci.add('network', `wireguard_${id}`);

		uci.set('network', sid, 'public_key', p.public_key);
		uci.set('network', sid, 'route_allowed_ips', '1');

		if (p.preshared_key)
			uci.set('network', sid, 'preshared_key', p.preshared_key);

		if (p.endpoint_host) {
			uci.set('network', sid, 'endpoint_host', p.endpoint_host);
			uci.set('network', sid, 'endpoint_port', `${p.endpoint_port ?? 51820}`);
		}

		if (length(p.allowed_ips))
			uci.set('network', sid, 'allowed_ips', conf.expand_default_routes(p.allowed_ips));

		if (p.persistent_keepalive)
			uci.set('network', sid, 'persistent_keepalive', `${p.persistent_keepalive}`);
	}
}

function set_routing_opts(uci, id) {
	const s = settings(uci);

	uci.set('network', id, 'ip4table', `${s.route_table}`);
	uci.set('network', id, 'ip6table', `${s.route_table}`);
	uci.set('network', id, 'fwmark', sprintf('0x%x', s.wg_fwmark));
}

/*
 * Networks
 */

function ip2int(ip) {
	const p = match(ip ?? '', /^(\d+)\.(\d+)\.(\d+)\.(\d+)$/);

	return p ? ((+p[1] << 24) | (+p[2] << 16) | (+p[3] << 8) | +p[4]) : null;
}

function prefix_mask(len) {
	return (len <= 0) ? 0 : ((0xffffffff << (32 - len)) & 0xffffffff);
}

function netmask_len(mask) {
	let n = ip2int(mask), len = 0;

	for (let i = 31; i >= 0 && n != null && (n & (1 << i)); i--)
		len++;

	return len || 24;
}

// First 192.168.x.0/24 (x >= start) not used by any interface.
function pick_subnet(uci, start) {
	let used = [];

	uci.foreach('network', 'interface', (s) => {
		for (let a in as_list(s.ipaddr)) {
			const p = split(a, '/');
			const ip = ip2int(p[0]);

			if (ip != null) {
				const mask = prefix_mask(p[1] != null ? +p[1] : netmask_len(s.netmask ?? '255.255.255.0'));
				push(used, [ ip & mask, mask ]);
			}
		}
	});

	for (let x = start; x < 255; x++) {
		const net = ip2int(`192.168.${x}.0`);

		if (!length(filter(used, (u) => (net & u[1] & prefix_mask(24)) == (u[0] & prefix_mask(24)))))
			return `192.168.${x}.1`;
	}

	return null;
}

function net_exists(uci, key) {
	return uci.get('network', NETS[key].net) == 'interface';
}

// The bridge device section named `name` (DSA "config device").
function bridge_sid(uci, name) {
	let sid = null;

	uci.foreach('network', 'device', (s) => {
		if (!sid && s.name == name && s.type == 'bridge')
			sid = s['.name'];
	});

	return sid;
}

// The LAN's bridge, e.g. "br-lan".
function lan_bridge(uci) {
	const dev = uci.get('network', 'lan', 'device');

	return (dev && bridge_sid(uci, dev)) ? dev : null;
}

/*
 * Creates the VPN network, and the Passwall network when Passwall is
 * installed: bridge, interface with a free subnet, DHCP pool and a firewall
 * zone with its forwardings. Existing parts are left alone. Returns the uci
 * packages it changed.
 */
function ensure_networks(uci) {
	const s = settings(uci);
	let changed = {};

	for (let key, n in NETS) {
		if (key == 'proxy' && !pw_installed(uci))
			continue;

		if (uci.get('network', n.dev_sid) == null) {
			uci.set('network', n.dev_sid, 'device');
			uci.set('network', n.dev_sid, 'name', n.bridge);
			uci.set('network', n.dev_sid, 'type', 'bridge');
			uci.set('network', n.dev_sid, 'bridge_empty', '1');
			changed.network = true;
		}

		if (!net_exists(uci, key)) {
			const addr = pick_subnet(uci, n.start);

			if (!addr)
				continue;

			uci.set('network', n.net, 'interface');
			uci.set('network', n.net, 'proto', 'static');
			uci.set('network', n.net, 'device', n.bridge);
			uci.set('network', n.net, 'ipaddr', addr);
			uci.set('network', n.net, 'netmask', '255.255.255.0');
			changed.network = true;
		}

		if (uci.get('dhcp', n.net) == null) {
			uci.set('dhcp', n.net, 'dhcp');
			uci.set('dhcp', n.net, 'interface', n.net);
			uci.set('dhcp', n.net, 'start', '100');
			uci.set('dhcp', n.net, 'limit', '150');
			uci.set('dhcp', n.net, 'leasetime', '12h');
			changed.dhcp = true;
		}

		if (uci.get('firewall', n.zone_sid) == null) {
			uci.set('firewall', n.zone_sid, 'zone');
			uci.set('firewall', n.zone_sid, 'name', n.zone);
			uci.set('firewall', n.zone_sid, 'network', [ n.net ]);
			// like the LAN: the router answers DHCP, DNS and LuCI
			uci.set('firewall', n.zone_sid, 'input', 'ACCEPT');
			uci.set('firewall', n.zone_sid, 'output', 'ACCEPT');
			uci.set('firewall', n.zone_sid, 'forward', 'REJECT');
			changed.firewall = true;
		}

		for (let f in NET_FWDS[key]) {
			const src = (f[1] == 'lan') ? s.lan_zone : (f[1] == 'wan') ? s.wan_zone : f[1];
			const dest = (f[2] == 'lan') ? s.lan_zone : (f[2] == 'wan') ? s.wan_zone : f[2];

			if (uci.get('firewall', f[0]) != 'forwarding' || uci.get('firewall', f[0], 'src') != src ||
			    uci.get('firewall', f[0], 'dest') != dest) {
				uci.set('firewall', f[0], 'forwarding');
				uci.set('firewall', f[0], 'src', src);
				uci.set('firewall', f[0], 'dest', dest);
				changed.firewall = true;
			}
		}
	}

	for (let pkg in keys(changed))
		uci.save(pkg);

	return keys(changed);
}

// Wired ports and the network they are on: { <port>: 'lan' | 'vpn' | 'proxy' }
// (the ports of the LAN bridge and of the app's bridges)
function port_roles(uci) {
	let roles = {};
	const lan = lan_bridge(uci);

	if (lan)
		for (let p in as_list(uci.get('network', bridge_sid(uci, lan), 'ports')))
			roles[p] = 'lan';

	for (let key, n in NETS)
		for (let p in as_list(uci.get('network', n.dev_sid, 'ports')))
			roles[p] = key;

	return roles;
}

// Wi-Fi networks (enabled access points) on a network: [ ssid, ... ]
function ssids_on(uci, net) {
	let list = [];

	uci.foreach('wireless', 'wifi-iface', (s) => {
		if ((s.mode ?? 'ap') == 'ap' && s.disabled != '1' && (net in as_list(s.network)) && s.ssid)
			push(list, s.ssid);
	});

	return uniq(list);
}

// true if a wired port or Wi-Fi network is on the app's network `key`
function net_in_use(uci, key) {
	if (!net_exists(uci, key))
		return false;

	return length(as_list(uci.get('network', NETS[key].dev_sid, 'ports'))) > 0 ||
		length(ssids_on(uci, NETS[key].net)) > 0;
}

/*
 * Profiles and what follows from the connected one
 */

// The VPN's DNS servers are only used by the devices that use the VPN
// (vpn_dns_nft), never as upstream servers of the router's own resolver:
// with only chosen devices, and in VPN through Passwall mode, the router's
// own traffic does not go through the VPN and could not reach them, and the
// router has to look up the VPN server's name before the tunnel is up. They
// are kept in wgpasswall.<profile>.dns instead of on the interface.
function sync_dns(uci, ids) {
	for (let id in ids) {
		const on_iface = as_list(uci.get('network', id, 'dns'));

		if (!length(on_iface))
			continue;

		if (uci.get('wgpasswall', id) == null)
			uci.set('wgpasswall', id, 'profile');

		uci.set('wgpasswall', id, 'dns', on_iface);
		uci.delete('network', id, 'dns');
	}
}

// The profile set to connected, or null.
function connected_profile(uci) {
	for (let id in profile_ids(uci))
		if (uci.get('network', id, 'auto') != '0')
			return id;

	return null;
}

// true if the connected profile sends all IPv4 traffic through the VPN but
// has no IPv6 default route: the devices' IPv6 would then go out directly
function ipv6_outside_vpn(uci) {
	const id = connected_profile(uci);

	if (!id)
		return false;

	let allowed = [];

	for (let p in load_profile(uci, id).peers)
		push(allowed, ...conf.collapse_default_routes(p.allowed_ips));

	return ('0.0.0.0/0' in allowed) && !('::/0' in allowed);
}

// The DNS servers the VPN network's devices get while a profile is
// connected: { v4, v6 } from the connected profile's DNS, or null.
function vpn_dns(uci) {
	const id = connected_profile(uci);

	if (!id)
		return null;

	const dns = load_profile(uci, id).iface.dns;
	const v4 = filter(dns, (a) => match(a, /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) != null)[0];
	const v6 = filter(dns, (a) => match(a, /^[0-9A-Fa-f:.]+$/) != null && index(a, ':') >= 0)[0];

	return (v4 || v6) ? { v4, v6 } : null;
}

// nftables rules sending the DNS of the VPN network's devices to the VPN's
// DNS servers. Their traffic goes through the VPN already, so the queries do
// too. Runs before Passwall's DNS redirect (dstnat - 1) and fw4's own
// (dstnat). IPv6 queries to the router are refused when the VPN has no IPv6
// DNS server, so the devices fall back to IPv4 instead of using the router.
// While the kill switch holds the VPN network offline (no profile set to
// connected), the router refuses its DNS queries too: it would otherwise
// look the names up through the internet connection's DNS.
// Without any of these the file only removes the table.
function vpn_dns_nft(uci) {
	const dns = vpn_dns(uci);
	let out = `table inet ${DNS_TABLE}\ndelete table inet ${DNS_TABLE}\n`;

	if (!net_exists(uci, 'vpn'))
		return out;

	const match_dns = `iifname "${NETS.vpn.bridge}" meta l4proto { tcp, udp }`;

	if (!connected_profile(uci) && settings(uci).killswitch)
		return out + `\ntable inet ${DNS_TABLE} {\n\tchain input {\n\t\ttype filter hook input priority filter - 5; policy accept;\n\t\t${match_dns} th dport 53 counter reject comment "WireGuard + Passwall: no DNS for the VPN network while the kill switch holds it offline"\n\t}\n}\n`;

	if (!dns)
		return out;

	out += `\ntable inet ${DNS_TABLE} {\n\tchain dstnat {\n\t\ttype nat hook prerouting priority dstnat - 10; policy accept;\n`;

	if (dns.v4)
		out += `\t\t${match_dns} meta nfproto ipv4 th dport 53 counter dnat ip to ${dns.v4}:53 comment "WireGuard + Passwall: VPN DNS for the VPN network"\n`;

	if (dns.v6)
		out += `\t\t${match_dns} meta nfproto ipv6 th dport 53 counter dnat ip6 to [${dns.v6}]:53 comment "WireGuard + Passwall: VPN DNS for the VPN network"\n`;

	out += '\t}\n';

	if (!dns.v6)
		out += `\n\tchain input {\n\t\ttype filter hook input priority filter - 5; policy accept;\n\t\t${match_dns} meta nfproto ipv6 ct original proto-dst 53 counter reject comment "WireGuard + Passwall: no IPv6 DNS from the router for the VPN network"\n\t}\n`;

	return out + '}\n';
}

// Creates or removes the policy routing rules shared by all profiles and
// makes sure every profile routes into the VPN table. Into the VPN table go
// traffic coming in from the VPN network, and the router's own traffic
// (coming from "loopback") unless the tunnel goes through Passwall: the
// proxy carrying the tunnel runs on the router, so routing the router's own
// traffic into the tunnel would make the proxy wait for itself; it goes out
// directly then. It never goes through Passwall (see pw_wanted_options).
function sync_routing(uci) {
	const s = settings(uci);
	const ids = profile_ids(uci);
	const unmarked = sprintf('0x0/0x%x', s.bypass_mask);
	let stale = [], nets = [ NETS.vpn.net ];

	for (let t in keys(RULE_SIDS))
		uci.foreach('network', t, (r) => {
			if (index(r['.name'], 'wgpasswall_rule') == 0)
				push(stale, r['.name']);
		});

	for (let sid in stale)
		uci.delete('network', sid);

	if (!via_passwall(uci) && uci.get('network', 'loopback') == 'interface')
		push(nets, 'loopback');

	if (length(ids)) {
		for (let t, sids in RULE_SIDS) {
			uci.set('network', sids[0], t);
			uci.set('network', sids[0], 'lookup', 'main');
			uci.set('network', sids[0], 'suppress_prefixlength', '0');
			uci.set('network', sids[0], 'priority', `${s.rule_priority}`);

			for (let net in nets) {
				const sid = `${sids[1]}_${net}`;

				uci.set('network', sid, t);
				uci.set('network', sid, 'in', net);
				uci.set('network', sid, 'mark', unmarked);
				uci.set('network', sid, 'lookup', `${s.route_table}`);
				uci.set('network', sid, 'priority', `${s.rule_priority + 10}`);
			}
		}
	}

	for (let id in ids)
		set_routing_opts(uci, id);

	sync_dns(uci, ids);
	uci.save('network');
	uci.save('wgpasswall');
}

// The VPN zone with all profiles, the kill switch, the IPv6 block and the
// DNS rules of the VPN network.
function sync_firewall(uci) {
	const s = settings(uci);
	const ids = profile_ids(uci);

	uci.set('firewall', ZONE_SID, 'zone');
	uci.set('firewall', ZONE_SID, 'name', ZONE);
	uci.set('firewall', ZONE_SID, 'input', 'REJECT');
	uci.set('firewall', ZONE_SID, 'output', 'ACCEPT');
	uci.set('firewall', ZONE_SID, 'forward', 'REJECT');
	uci.set('firewall', ZONE_SID, 'masq', '1');
	uci.set('firewall', ZONE_SID, 'masq6', '1');
	uci.set('firewall', ZONE_SID, 'mtu_fix', '1');

	if (length(ids))
		uci.set('firewall', ZONE_SID, 'network', ids);
	else
		uci.delete('firewall', ZONE_SID, 'network');

	// Rules are evaluated before zone forwardings, so this rejects VPN network
	// -> WAN traffic even though such a forwarding exists.
	uci.set('firewall', KS_SID, 'rule');
	uci.set('firewall', KS_SID, 'name', 'WireGuard + Passwall kill switch');
	uci.set('firewall', KS_SID, 'src', NETS.vpn.zone);
	uci.set('firewall', KS_SID, 'dest', s.wan_zone);
	uci.set('firewall', KS_SID, 'proto', 'all');
	uci.set('firewall', KS_SID, 'family', 'any');
	uci.set('firewall', KS_SID, 'target', 'REJECT');
	uci.set('firewall', KS_SID, 'enabled', s.killswitch ? '1' : '0');
	uci.delete('firewall', KS_SID, 'src_mac');

	// IPv6 of the VPN network must not go out directly while the VPN only
	// carries IPv4 (see ipv6_outside_vpn)
	uci.set('firewall', NO_V6_SID, 'rule');
	uci.set('firewall', NO_V6_SID, 'name', 'WireGuard + Passwall: no IPv6 outside the VPN');
	uci.set('firewall', NO_V6_SID, 'src', NETS.vpn.zone);
	uci.set('firewall', NO_V6_SID, 'dest', s.wan_zone);
	uci.set('firewall', NO_V6_SID, 'proto', 'all');
	uci.set('firewall', NO_V6_SID, 'family', 'ipv6');
	uci.set('firewall', NO_V6_SID, 'target', 'REJECT');
	uci.set('firewall', NO_V6_SID, 'enabled', ipv6_outside_vpn(uci) ? '1' : '0');
	uci.delete('firewall', NO_V6_SID, 'src_mac');

	// per-device marking of earlier versions
	uci.delete('firewall', OLD_MARK_SID);

	// the file must exist whenever the include does, or fw4 fails to load
	const nft = vpn_dns_nft(uci);

	if (readfile(DNS_NFT) != nft) {
		mkdir(replace(DNS_NFT, /\/[^\/]*$/, ''));
		writefile(DNS_NFT, nft);
	}

	uci.set('firewall', DNS_SID, 'include');
	uci.set('firewall', DNS_SID, 'type', 'nftables');
	uci.set('firewall', DNS_SID, 'path', DNS_NFT);
	uci.set('firewall', DNS_SID, 'position', 'ruleset-append');

	uci.save('firewall');
}

// Firewall reloads and Passwall restarts of all luci-apps go through this
// lock, one at a time: a firewall reload in the middle of a Passwall
// restart re-adds Passwall's rules (its firewall include) after Passwall
// removed them, and they then stay behind while Passwall is off, cutting
// off the router's own connections. Runs in the background, as a Passwall
// restart can take long and rpcd must not wait for it.
//
// The lock is held on file descriptor 9 of a subshell and the commands run
// with it closed: daemons a command starts (Passwall's xray, dnsmasq, ...)
// would otherwise inherit it and hold the lock for as long as they run,
// blocking every later reload. The "; true" keeps the shell from running the
// last command in place of the subshell, which would close the lock early.
// The file name changed with that fix, as daemons started by older versions
// may still hold the old one.
const FW_LOCK = '/var/lock/luci-apps.lock';

// The commands as one script; failures end up in the system log.
function locked_script(cmds) {
	return join('; ', map(cmds, (c) => `${c} || logger -t luci-apps ${shell_quote(`failed: ${c}`)}`));
}

function run_locked(cmds) {
	if (!length(cmds))
		return;

	system(`(mkdir -p /var/lock; exec 9>${FW_LOCK}; flock 9; sh -c ${shell_quote(locked_script(cmds))} 9>&-; true) >/dev/null 2>&1 &`);
}

// Passwall commands queued last: a queued job whose Passwall commands are
// no longer the latest skips them, as the later job restarts Passwall with
// everything committed by then (each restart takes half a minute, so a few
// quick changes would otherwise restart it again and again).
const PW_NEXT = getenv('WGPASSWALL_PW_NEXT') ?? '/var/run/luci-apps-passwall.next';

// Commits, reloads the network and then, under the lock, the firewall, DHCP
// and any Passwall commands in `after` (unless later ones were queued).
function apply(uci, packages, after) {
	let cmds = [];

	for (let pkg in uniq(packages))
		if (pkg != 'passwall' || uci.get_all('passwall') != null)
			uci.commit(pkg);

	if ('network' in packages)
		ubus.call('network', 'reload', {});

	if ('firewall' in packages)
		push(cmds, '/etc/init.d/firewall reload');

	if ('dhcp' in packages)
		push(cmds, '/etc/init.d/dnsmasq reload');

	if (length(after)) {
		const token = trim(readfile('/proc/sys/kernel/random/uuid') ?? '') || `${time()}`;

		writefile(PW_NEXT, token);
		push(cmds, `[ "$(cat ${PW_NEXT} 2>/dev/null)" = ${shell_quote(token)} ] || exit 0`);
	}

	run_locked([ ...cmds, ...(after ?? []) ]);
}

function iface_up(id) {
	ubus.call('network.interface', 'up', { interface: id });
}

function iface_down(id) {
	ubus.call('network.interface', 'down', { interface: id });
}

function runtime_status() {
	let wg = {}, ifaces = {};

	// interface line: name, privkey, pubkey, port, fwmark
	// peer line: name, pubkey, psk, endpoint, allowed, handshake, rx, tx, keepalive
	for (let line in split(run('wg show all dump') ?? '', '\n')) {
		const f = split(line, '\t');

		if (length(f) == 5)
			wg[f[0]] = { public_key: f[2], listen_port: f[3], peers: [] };
		else if (length(f) == 9 && wg[f[0]])
			push(wg[f[0]].peers, {
				public_key: f[1],
				endpoint: (f[3] != '(none)') ? f[3] : null,
				latest_handshake: +f[5],
				rx_bytes: +f[6],
				tx_bytes: +f[7]
			});
	}

	for (let i in ubus.call('network.interface', 'dump', {})?.interface)
		ifaces[i.interface] = i;

	return { wg, ifaces };
}

/*
 * Passwall. The options the app controls while Passwall is needed are saved
 * in wgpasswall.passwall the first time (UNSET marks an option that did not
 * exist) and restored exactly once nothing needs Passwall anymore.
 */
const RELAY_BASE_PORT = 51821;
const RELAY_STATUS = '/var/run/wgpasswall/relay-status.json';
const PW_MTU = 1280;
const UNSET = '__unset__';
// Passwall options the app controls while Passwall is needed
const PW_MANAGED = [ 'enabled', 'client_proxy', 'tcp_proxy_mode', 'udp_proxy_mode', 'acl_enable', 'localhost_proxy' ];

function first_section(uci, config, stype) {
	let sid = null;

	uci.foreach(config, stype, (s) => {
		if (!sid)
			sid = s['.name'];
	});

	return sid;
}

function pw_nodes(uci) {
	let nodes = [];

	uci.foreach('passwall', 'nodes', (s) => {
		if (s.type && s.remarks)
			push(nodes, {
				id: s['.name'],
				label: sprintf('%s: %s%s', s.type, s.protocol ? `[${s.protocol}] ` : '', s.remarks)
			});
	});

	return nodes;
}

function pw_running() {
	return length(run('nft list chain inet passwall PSW_OUTPUT_MANGLE 2>/dev/null | head -n 1') ?? '') > 0;
}

function relay_restart() {
	system('/etc/init.d/wgpasswall restart >/dev/null 2>&1 &');
}

// Relay state of the tunnel whose endpoint is 127.0.0.1:<port>: true if the
// relay has a working association with the proxy, false if not, null if
// unknown.
function relay_up(endpoint) {
	const m = match(endpoint ?? '', /^127\.0\.0\.1:([0-9]+)$/);

	if (!m)
		return false;

	const st = json(readfile(RELAY_STATUS) ?? 'null');

	if (!st || time() - st.updated > 10)
		return null;

	for (let r in st.relays)
		if (r.listen == +m[1])
			return r.up;

	return null;
}

// Lowers a profile's MTU for the proxy overhead, remembering the original.
function pw_apply_mtu(uci, id) {
	if (uci.get('wgpasswall', id) == null)
		uci.set('wgpasswall', id, 'profile');

	const cur = uci.get('network', id, 'mtu');

	if (uci.get('wgpasswall', id, 'mtu_backup') == null)
		uci.set('wgpasswall', id, 'mtu_backup', cur ?? UNSET);

	if (cur == null || +cur > PW_MTU)
		uci.set('network', id, 'mtu', `${PW_MTU}`);
}

function pw_restore_mtu(uci, id) {
	const backup = uci.get('wgpasswall', id, 'mtu_backup');

	if (backup == null)
		return;

	if (backup == UNSET)
		uci.delete('network', id, 'mtu');
	else
		uci.set('network', id, 'mtu', backup);

	uci.delete('wgpasswall', id, 'mtu_backup');
}

// Points every peer at the local relay while the tunnel goes through
// Passwall, and back at its real server otherwise.
function relay_sync(uci) {
	const relay = via_passwall(uci);
	let port = RELAY_BASE_PORT;

	for (let id in profile_ids(uci)) {
		let peers = [];

		uci.foreach('network', `wireguard_${id}`, (s) => push(peers, s));

		for (let s in peers) {
			const sid = s['.name'];
			const orig_host = s.wgpasswall_orig_host;

			if (relay) {
				const host = orig_host ?? s.endpoint_host;

				if (!host)
					continue;

				if (!orig_host) {
					uci.set('network', sid, 'wgpasswall_orig_host', host);
					uci.set('network', sid, 'wgpasswall_orig_port', s.endpoint_port || '51820');
				}

				uci.set('network', sid, 'endpoint_host', '127.0.0.1');
				uci.set('network', sid, 'endpoint_port', `${port++}`);
			}
			else if (orig_host) {
				uci.set('network', sid, 'endpoint_host', orig_host);
				uci.set('network', sid, 'endpoint_port', s.wgpasswall_orig_port || '51820');
				uci.delete('network', sid, 'wgpasswall_orig_host');
				uci.delete('network', sid, 'wgpasswall_orig_port');
			}
		}

		// the proxy's overhead needs a smaller tunnel MTU
		if (relay)
			pw_apply_mtu(uci, id);
		else
			pw_restore_mtu(uci, id);
	}

	uci.save('network');
	uci.save('wgpasswall');
}

function pw_baseline_saved(uci) {
	return uci.get('wgpasswall', 'passwall', 'pw_saved') == '1';
}

function pw_save_baseline(uci, g, fw) {
	if (pw_baseline_saved(uci)) {
		// options added to PW_MANAGED after the copy was saved: the app has
		// not changed them yet, so their current value is the original
		for (let opt in PW_MANAGED)
			if (uci.get('wgpasswall', 'passwall', `pw_${opt}`) == null)
				uci.set('wgpasswall', 'passwall', `pw_${opt}`, uci.get('passwall', g, opt) ?? UNSET);

		return;
	}

	uci.set('wgpasswall', 'passwall', 'passwall');

	for (let opt in PW_MANAGED)
		uci.set('wgpasswall', 'passwall', `pw_${opt}`, uci.get('passwall', g, opt) ?? UNSET);

	uci.set('wgpasswall', 'passwall', 'pw_udp_proxy_drop_ports',
		(fw && uci.get('passwall', fw, 'udp_proxy_drop_ports')) ?? UNSET);
	uci.set('wgpasswall', 'passwall', 'pw_service_enabled',
		system('/etc/init.d/passwall enabled') == 0 ? '1' : '0');
	uci.set('wgpasswall', 'passwall', 'pw_saved', '1');
}

// Writes the saved original values back into Passwall's config.
function pw_restore_baseline(uci, g, fw) {
	for (let opt in PW_MANAGED) {
		const v = uci.get('wgpasswall', 'passwall', `pw_${opt}`);

		if (v == UNSET)
			uci.delete('passwall', g, opt);
		else if (v != null)
			uci.set('passwall', g, opt, v);
	}

	const drop = uci.get('wgpasswall', 'passwall', 'pw_udp_proxy_drop_ports');

	if (fw && drop == UNSET)
		uci.delete('passwall', fw, 'udp_proxy_drop_ports');
	else if (fw && drop != null)
		uci.set('passwall', fw, 'udp_proxy_drop_ports', drop);
}

// Passwall's node (its own choice): { id, label }, or null if none is set.
function pw_node(uci) {
	const g = first_section(uci, 'passwall', 'global');
	const id = g ? uci.get('passwall', g, 'node') : null;

	if (!id || uci.get('passwall', id) != 'nodes')
		return null;

	const n = uci.get_all('passwall', id);

	return { id, label: sprintf('%s: %s%s', n.type ?? '?', n.protocol ? `[${n.protocol}] ` : '', n.remarks ?? id) };
}

// true while something needs Passwall: devices on the Passwall network, or
// the tunnel of a connected profile going through it
function pw_needed(uci) {
	return pw_installed(uci) &&
		(net_in_use(uci, 'proxy') || (via_passwall(uci) && connected_profile(uci) != null));
}

// The networks Passwall carries: the Passwall network, while in use.
function pw_networks(uci) {
	return (pw_installed(uci) && net_in_use(uci, 'proxy')) ? [ NETS.proxy.net ] : [];
}

function pw_net_acl_sid(net) {
	return PW_NET_ACL_PREFIX + replace(net, /[^A-Za-z0-9_]/g, '_');
}

function is_app_acl(sid) {
	if (index(sid, PW_NET_ACL_PREFIX) == 0 || sid in OLD_ACL_SIDS)
		return true;

	for (let p in OLD_ACL_PREFIXES)
		if (index(sid, p) == 0)
			return true;

	return false;
}

// The access control rules of the app: "Proxy" (global node and settings,
// run by the global instance) for every network Passwall carries. Others,
// and those of earlier versions, are removed; the user's own rules are left
// alone.
function pw_sync_acl(uci) {
	const nets = pw_networks(uci);
	let wanted = {}, ours = [];

	for (let net in nets)
		wanted[pw_net_acl_sid(net)] = net;

	uci.foreach('passwall', null, (s) => {
		if (is_app_acl(s['.name']))
			push(ours, s['.name']);
	});

	for (let sid in ours)
		if (!wanted[sid])
			uci.delete('passwall', sid);

	for (let sid, net in wanted) {
		uci.set('passwall', sid, 'acl_rule');
		uci.set('passwall', sid, 'enabled', '1');
		uci.set('passwall', sid, 'remarks', `WireGuard + Passwall: the ${net} network`);
		uci.set('passwall', sid, 'interface', net);
		// "mode" 1 is Proxy (26.8.10+; older versions proxy by default)
		uci.set('passwall', sid, 'use_global_config', '1');
		uci.set('passwall', sid, 'mode', '1');
	}
}

// The values of PW_MANAGED while Passwall is needed (UNSET: not set, null:
// left alone). Client Proxy is off: the networks Passwall carries have their
// own rules, so a guest network, the LAN and the VPN network stay out.
// Localhost Proxy is off: with it, the node's own connection to its server
// can be caught by the rules for the router's traffic and loop back into
// Passwall (seen with an Xray hysteria node: nothing got through, for the
// Passwall network either). The router's own traffic goes through a
// directly connected tunnel, or out directly; Passwall's own DNS lookups
// through its node do not need Localhost Proxy, nor does the relay.
function pw_wanted_options(uci) {
	const own_acl = uci.get('wgpasswall', 'passwall', 'pw_acl_enable');

	return {
		enabled: '1',
		client_proxy: '0',
		tcp_proxy_mode: 'proxy',
		udp_proxy_mode: 'proxy',
		// without networks to carry, the user's own setting (UNSET: none)
		acl_enable: length(pw_networks(uci)) ? '1' : own_acl,
		localhost_proxy: '0'
	};
}

// Passwall's configuration as text, to see whether it changed: sections and
// options sorted, as deleting and setting an option again moves it.
function pw_snapshot(uci) {
	const all = uci.get_all('passwall') ?? {};
	let out = [];

	for (let sid in sort(keys(all)))
		for (let opt in sort(keys(all[sid])))
			if (opt == '.type' || index(opt, '.') != 0)
				push(out, `${sid}.${opt}=${sprintf('%J', all[sid][opt])}`);

	return join('\n', out);
}

/*
 * Brings Passwall's configuration in line with what the networks and the
 * tunnel need. Returns the commands for apply(): (re)starting Passwall when
 * its configuration changed while needed, or restoring its own state once
 * it is no longer needed.
 */
function pw_sync(uci) {
	if (!pw_installed(uci))
		return [];

	const g = first_section(uci, 'passwall', 'global');
	const fw = first_section(uci, 'passwall', 'global_forwarding');
	const before = pw_snapshot(uci);
	let cmds = [];

	if (!g)
		return [];

	if (pw_needed(uci)) {
		pw_save_baseline(uci, g, fw);

		for (let opt, v in pw_wanted_options(uci))
			if (v == UNSET)
				uci.delete('passwall', g, opt);
			else if (v != null)
				uci.set('passwall', g, opt, v);

		pw_sync_acl(uci);

		if (pw_snapshot(uci) != before || !pw_running())
			cmds = [ '/etc/init.d/passwall enable', '/etc/init.d/passwall restart' ];
	}
	else {
		pw_sync_acl(uci);

		if (pw_baseline_saved(uci)) {
			const service = uci.get('wgpasswall', 'passwall', 'pw_service_enabled');

			pw_restore_baseline(uci, g, fw);
			uci.delete('wgpasswall', 'passwall');
			uci.set('wgpasswall', 'passwall', 'passwall');
			cmds = (service == '0') ? [ '/etc/init.d/passwall disable', '/etc/init.d/passwall restart' ]
				: [ '/etc/init.d/passwall restart' ];
		}
		else if (pw_snapshot(uci) != before) {
			cmds = [ '/etc/init.d/passwall restart' ];	// rules of the app removed
		}
	}

	uci.save('passwall');
	uci.save('wgpasswall');

	return cmds;
}

/*
 * Old settings: the four modes and the per-device choice of earlier versions
 * become "via_passwall"; devices now pick a network instead.
 */
function migrate(uci) {
	const mode = uci.get('wgpasswall', 'settings', 'mode');

	if (mode == null && uci.get('wgpasswall', 'settings', 'scope') == null)
		return;

	ensure_settings(uci);

	if (mode == 'vpn_passwall')
		uci.set('wgpasswall', 'settings', 'via_passwall', '1');

	for (let opt in [ 'mode', 'scope', 'vpn_device', 'device_mark', 'pw_node', 'last_profile' ])
		uci.delete('wgpasswall', 'settings', opt);

	uci.save('wgpasswall');
}

/*
 * Applies networks, routing, firewall, the relay and Passwall to the current
 * settings. Returns { packages, pw } for apply().
 */
function sync_all(uci) {
	migrate(uci);

	const packages = ensure_networks(uci);

	relay_sync(uci);
	sync_routing(uci);
	sync_firewall(uci);

	const pw = pw_sync(uci);

	return {
		packages: [ ...packages, 'wgpasswall', 'network', 'firewall', 'passwall' ],
		pw
	};
}

// sync_all() and apply(), plus the relay (started while the tunnel goes
// through Passwall, stopped otherwise).
function sync_apply(uci) {
	const r = sync_all(uci);

	apply(uci, r.packages, r.pw);
	relay_restart();
}

/*
 * What differs from the settings the app applied, e.g. after a change on
 * Passwall's own page or a firewall reload that did not happen. Returns a
 * list of codes: pw_settings (Passwall's options), pw_acl (the app's rules),
 * pw_no_node (Passwall needed but no node set), fw_rules (firewall rules saved
 * but not active) and fw_missing (firewall rules or networks removed).
 */
function drift(uci) {
	let issues = [];

	if (pw_installed(uci) && pw_needed(uci)) {
		const g = first_section(uci, 'passwall', 'global');

		for (let opt, v in pw_wanted_options(uci))
			if (v != null && (g ? uci.get('passwall', g, opt) : null) != ((v == UNSET) ? null : v)) {
				push(issues, 'pw_settings');
				break;
			}

		let wanted = {}, acl_ok = true;

		for (let net in pw_networks(uci)) {
			const r = uci.get_all('passwall', pw_net_acl_sid(net));

			wanted[pw_net_acl_sid(net)] = true;

			if (!r || r['.type'] != 'acl_rule' || r.enabled != '1' || r.interface != net || r.mode != '1')
				acl_ok = false;
		}

		uci.foreach('passwall', 'acl_rule', (r) => {
			if (is_app_acl(r['.name']) && !wanted[r['.name']])
				acl_ok = false;
		});

		if (!acl_ok)
			push(issues, 'pw_acl');

		if (!pw_node(uci))
			push(issues, 'pw_no_node');
	}

	// rules that must be active; the firewall marks its rules with these comments
	let want = [];

	if (uci.get('firewall', KS_SID, 'enabled') == '1')
		push(want, 'WireGuard + Passwall kill switch');

	if (uci.get('firewall', NO_V6_SID, 'enabled') == '1')
		push(want, 'WireGuard + Passwall: no IPv6 outside the VPN');

	// every rule of the DNS table counts its packets
	const dns_rules = index(vpn_dns_nft(uci), 'counter') >= 0;

	if (!net_exists(uci, 'vpn') || uci.get('firewall', NETS.vpn.zone_sid) == null ||
	    uci.get('firewall', DNS_SID) == null || readfile(DNS_NFT) != vpn_dns_nft(uci) ||
	    (length(profile_ids(uci)) && uci.get('firewall', ZONE_SID) == null))
		push(issues, 'fw_missing');
	// skipped while queued reloads are still running (they hold the lock)
	else if (system(`flock -n ${FW_LOCK} true >/dev/null 2>&1`) == 0) {
		const live = length(want) ? run('nft list table inet fw4') : null;
		let ok = true;

		// no fw4 table (another firewall, or not started): nothing to compare
		if (length(live))
			for (let c in want)
				if (index(live, `!fw4: ${c}"`) < 0)
					ok = false;

		if (length(live) || !length(want))
			if ((index(run(`nft list table inet ${DNS_TABLE}`) ?? '', 'counter') >= 0) != dns_rules)
				ok = false;

		if (!ok)
			push(issues, 'fw_rules');
	}

	return issues;
}

function local_pubkey(private_key) {
	if (!match(private_key ?? '', /^[A-Za-z0-9+\/]{42}[AEIMQUYcgkosw480]=$/))
		return null;

	return trim(run(`echo ${shell_quote(private_key)} | wg pubkey`) ?? '') || null;
}

// A network's IPv4 address and subnet, e.g. { address: '192.168.8.1',
// subnet: '192.168.8.0/24' }; "ipaddr" may be a list and carry a prefix.
function net_address(uci, net) {
	const p = split(as_list(uci.get('network', net, 'ipaddr'))[0] ?? '', '/');
	const ip = ip2int(p[0]);

	if (ip == null)
		return { address: null, subnet: null };

	const len = (p[1] != null) ? +p[1] : netmask_len(uci.get('network', net, 'netmask') ?? '255.255.255.0');
	const n = ip & prefix_mask(len);

	return { address: p[0], subnet: sprintf('%d.%d.%d.%d/%d', (n >> 24) & 255, (n >> 16) & 255, (n >> 8) & 255, n & 255, len) };
}

// The networks for the page: address, wired ports and Wi-Fi networks on each.
function networks_status(uci) {
	const roles = port_roles(uci);
	const ports_of = (role) => sort(filter(keys(roles), (p) => roles[p] == role));
	let res = {
		lan: {
			exists: uci.get('network', 'lan') == 'interface',
			...net_address(uci, 'lan'),
			ports: ports_of('lan'),
			ssids: ssids_on(uci, 'lan')
		}
	};

	for (let key, n in NETS)
		res[key] = {
			exists: net_exists(uci, key),
			...net_address(uci, n.net),
			ports: ports_of(key),
			ssids: ssids_on(uci, n.net)
		};

	return res;
}

const methods = {
	status: {
		call: function() {
			const uci = cursor();
			const rt = runtime_status();
			const s = settings(uci);
			const now = time();
			const relayed = via_passwall(uci);
			let profiles = [];

			for (let id in profile_ids(uci)) {
				const cfg = load_profile(uci, id);
				const wg = rt.wg[id];
				const ifc = rt.ifaces[id];
				const peer = cfg.peers[0] ?? {};
				let handshake = 0, rx = 0, tx = 0, endpoint = null;

				for (let p in wg?.peers) {
					if (p.latest_handshake > handshake)
						handshake = p.latest_handshake;

					rx += p.rx_bytes;
					tx += p.tx_bytes;
					if (!endpoint)
						endpoint = p.endpoint;
				}

				let allowed = [];

				for (let p in cfg.peers)
					push(allowed, ...conf.collapse_default_routes(p.allowed_ips));

				push(profiles, {
					id,
					label: uci.get('wgpasswall', id, 'label') || substr(id, length(PREFIX)),
					auto: uci.get('network', id, 'auto') != '0',
					up: !!ifc?.up,
					pending: !!ifc?.pending,
					error: ifc?.errors?.[0]?.code,
					uptime: ifc?.uptime,
					addresses: cfg.iface.addresses,
					dns: cfg.iface.dns,
					// the configured server; the live endpoint is the relay through Passwall
					endpoint: (relayed || !endpoint) ? (peer.endpoint_host
						? ((index(peer.endpoint_host, ':') >= 0) ? `[${peer.endpoint_host}]` : peer.endpoint_host) + `:${peer.endpoint_port ?? 51820}`
						: null) : endpoint,
					allowed_ips: allowed,
					full_tunnel: conf.is_full_tunnel(allowed),
					peer_count: length(cfg.peers),
					public_key: wg?.public_key ?? local_pubkey(cfg.iface.private_key),
					latest_handshake: handshake,
					handshake_age: handshake ? now - handshake : null,
					rx_bytes: rx,
					tx_bytes: tx,
					proxied: (relayed && ifc?.up) ? relay_up(endpoint) : null
				});
			}

			return {
				// version of what status returns; the page checks it to
				// notice it is an outdated copy from the browser's cache
				api: API_VERSION,
				settings: s,
				via_passwall: relayed,
				wan_zone_ok: zone_exists(uci, s.wan_zone),
				killswitch_active: s.killswitch && uci.get('firewall', KS_SID, 'enabled') == '1',
				proxy_apps: detect_proxy_apps(uci),
				drift: drift(uci),
				vpn_dns: vpn_dns(uci),
				ipv6_blocked: ipv6_outside_vpn(uci),
				networks: networks_status(uci),
				passwall: {
					installed: pw_installed(uci),
					needed: pw_needed(uci),
					running: pw_installed(uci) ? pw_running() : false,
					node: pw_installed(uci) ? pw_node(uci) : null
				},
				profiles
			};
		}
	},

		// Validates a configuration and returns a summary, without saving.
	parse: {
		args: { conf: '' },
		call: function(req) {
			const r = conf.parse(req.args.conf);

			if (r.error)
				return { error: r.error };

			let allowed = [];

			for (let p in r.peers)
				push(allowed, ...p.allowed_ips);

			return {
				addresses: r.iface.addresses,
				dns: r.iface.dns,
				endpoint: r.peers[0].endpoint_host
					? `${r.peers[0].endpoint_host}:${r.peers[0].endpoint_port}` : null,
				peer_count: length(r.peers),
				allowed_ips: allowed,
				full_tunnel: conf.is_full_tunnel(allowed),
				// peers without PersistentKeepalive: behind NAT or a proxy their
				// tunnel goes quiet and can stall when idle (the page offers to add it)
				keepalive_missing: length(filter(r.peers, (p) => !p.persistent_keepalive)),
				warnings: r.warnings
			};
		}
	},

		get: {
		args: { id: '' },
		call: function(req) {
			const uci = cursor();
			const id = req.args.id;

			if (!is_profile(uci, id))
				return { error: 'No such profile' };

			const cfg = load_profile(uci, id);
			const mtu_backup = uci.get('wgpasswall', id, 'mtu_backup');

			// show the profile's own MTU, not the one lowered for Passwall
			if (mtu_backup != null)
				cfg.iface.mtu = (mtu_backup == UNSET) ? null : +mtu_backup;

			return {
				id,
				label: uci.get('wgpasswall', id, 'label') || substr(id, length(PREFIX)),
				conf: conf.serialize(cfg)
			};
		}
	},

	// Creates (no id) or replaces (id given) a profile from .conf text.
	save: {
		args: { id: '', label: '', conf: '', connect: false },
		call: function(req) {
			const uci = cursor();
			const label = trim(req.args.label ?? '');
			const r = conf.parse(req.args.conf);

			if (r.error)
				return { error: r.error };

			if (!length(label) || length(label) > 64)
				return { error: 'Please enter a name of 1 to 64 characters' };

			let id = req.args.id;
			let auto = false;

			if (length(id)) {
				if (!is_profile(uci, id))
					return { error: 'No such profile' };

				auto = uci.get('network', id, 'auto') != '0';
			}
			else {
				id = slugify(uci, label);
			}

			const connect_now = req.args.connect || auto;

			// the new .conf defines the DNS servers; sync_dns keeps them aside
			uci.delete('wgpasswall', id, 'dns');

			if (req.args.connect) {
				for (let other in profile_ids(uci))
					if (other != id)
						uci.set('network', other, 'auto', '0');
			}

			write_profile(uci, id, r, connect_now);
			ensure_settings(uci);
			uci.set('wgpasswall', id, 'profile');
			uci.set('wgpasswall', id, 'label', label);
			uci.delete('wgpasswall', id, 'mtu_backup');	// the new .conf defines the MTU
			uci.save('wgpasswall');

			sync_apply(uci);

			if (connect_now)
				iface_up(id);

			return { id, warnings: r.warnings };
		}
	},

	remove: {
		args: { id: '' },
		call: function(req) {
			const uci = cursor();
			const id = req.args.id;

			if (!is_profile(uci, id))
				return { error: 'No such profile' };

			iface_down(id);

			let peers = [];

			uci.foreach('network', `wireguard_${id}`, (s) => push(peers, s['.name']));

			for (let sid in peers)
				uci.delete('network', sid);

			uci.delete('network', id);
			uci.delete('wgpasswall', id);
			uci.save('wgpasswall');

			sync_apply(uci);

			return { result: true };
		}
	},

	// Connects a profile and disconnects all other profiles.
	connect: {
		args: { id: '' },
		call: function(req) {
			const uci = cursor();
			const id = req.args.id;

			if (!is_profile(uci, id))
				return { error: 'No such profile' };

			for (let other in profile_ids(uci)) {
				if (other != id) {
					uci.set('network', other, 'auto', '0');
					iface_down(other);
				}
			}

			uci.set('network', id, 'auto', '1');
			uci.save('network');
			sync_apply(uci);
			iface_up(id);

			return { result: true };
		}
	},

	disconnect: {
		args: { id: '' },
		call: function(req) {
			const uci = cursor();
			const id = req.args.id;

			if (!is_profile(uci, id))
				return { error: 'No such profile' };

			uci.set('network', id, 'auto', '0');
			uci.save('network');
			sync_apply(uci);
			iface_down(id);

			return { result: true };
		}
	},

	/*
	 * Settings: "killswitch" (the VPN network only reaches the internet
	 * through the tunnel) and "via_passwall" (the tunnel goes through
	 * Passwall). Omitted ones stay as they are.
	 */
	set_options: {
		args: { killswitch: false, via_passwall: false },
		call: function(req) {
			const uci = cursor();
			const a = req.args;

			if (a.via_passwall === true && !pw_installed(uci))
				return { error: 'Passwall is not installed' };

			if (a.killswitch === true && !zone_exists(uci, settings(uci).wan_zone))
				return { error: `The firewall zone "${settings(uci).wan_zone}" is required for the kill switch` };

			ensure_settings(uci);

			if (a.killswitch != null)
				uci.set('wgpasswall', 'settings', 'killswitch', a.killswitch ? '1' : '0');

			if (a.via_passwall != null)
				uci.set('wgpasswall', 'settings', 'via_passwall', a.via_passwall ? '1' : '0');

			uci.save('wgpasswall');
			sync_apply(uci);

			return { result: true };
		}
	},

	/*
	 * Moves wired ports between the networks: { ports: { <port>: 'lan' |
	 * 'vpn' | 'proxy' } }. Only ports already on one of them can be moved.
	 */
	set_ports: {
		args: { ports: {} },
		call: function(req) {
			const uci = cursor();

			migrate(uci);

			const packages = ensure_networks(uci);
			const roles = port_roles(uci);
			const lan = lan_bridge(uci);
			const bridges = { lan: lan ? bridge_sid(uci, lan) : null, vpn: NETS.vpn.dev_sid, proxy: NETS.proxy.dev_sid };

			for (let port, role in req.args.ports ?? {}) {
				if (roles[port] == null)
					return { error: `Unknown port: ${port}` };

				if (!bridges[role] || uci.get('network', bridges[role]) == null)
					return { error: `This network is not available: ${role}` };
			}

			for (let port, role in req.args.ports ?? {}) {
				if (roles[port] == role)
					continue;

				const from = bridges[roles[port]];
				const rest = filter(as_list(uci.get('network', from, 'ports')), (p) => p != port);

				// uci does not store an empty list
				if (length(rest))
					uci.set('network', from, 'ports', rest);
				else
					uci.delete('network', from, 'ports');

				uci.set('network', bridges[role], 'ports', uniq([ ...as_list(uci.get('network', bridges[role], 'ports')), port ]));
				roles[port] = role;
			}

			uci.save('network');

			const r = sync_all(uci);

			apply(uci, [ ...packages, ...r.packages ], r.pw);
			relay_restart();

			return { result: true, ports: roles };
		}
	},

	/*
	 * Brings everything in line after a change elsewhere, e.g. Wi-Fi Setup
	 * putting a Wi-Fi network on the Passwall network. Passwall restarts only
	 * if its settings changed.
	 */
	sync: {
		call: function() {
			sync_apply(cursor());

			return { result: true };
		}
	},

	/*
	 * Applies everything again: networks, routing, firewall, the relay and
	 * Passwall; reloads the firewall and restarts Passwall when it is needed.
	 * For when something was changed elsewhere or did not apply.
	 */
	reapply: {
		call: function() {
			const uci = cursor();
			const r = sync_all(uci);

			if (pw_needed(uci) && !length(r.pw))
				r.pw = [ '/etc/init.d/passwall restart' ];

			apply(uci, r.packages, r.pw);
			relay_restart();

			return { result: true };
		}
	},

	/*
	 * Undoes what the app set up, for its removal: wired ports and Wi-Fi
	 * networks go back to the LAN, the VPN and Passwall networks, the kill
	 * switch and the app's firewall rules are removed, and Passwall gets its
	 * own settings back. The profiles stay, disconnected.
	 */
	uninstall: {
		call: function() {
			const uci = cursor();
			const lan = lan_bridge(uci);
			const lan_sid = lan ? bridge_sid(uci, lan) : null;
			let wifi = false, after = [];

			for (let id in profile_ids(uci)) {
				uci.set('network', id, 'auto', '0');
				iface_down(id);
			}

			ensure_settings(uci);
			uci.set('wgpasswall', 'settings', 'killswitch', '0');
			uci.set('wgpasswall', 'settings', 'via_passwall', '0');
			relay_sync(uci);

			for (let key, n in NETS) {
				const ports = as_list(uci.get('network', n.dev_sid, 'ports'));

				if (lan_sid && length(ports))
					uci.set('network', lan_sid, 'ports', uniq([ ...as_list(uci.get('network', lan_sid, 'ports')), ...ports ]));

				uci.foreach('wireless', 'wifi-iface', (s) => {
					const nets = as_list(s.network);

					if (n.net in nets) {
						const rest = filter(nets, (x) => x != n.net);

						uci.set('wireless', s['.name'], 'network', length(rest) ? rest : [ 'lan' ]);
						wifi = true;
					}
				});

				uci.delete('network', n.dev_sid);
				uci.delete('network', n.net);
				uci.delete('dhcp', n.net);
				uci.delete('firewall', n.zone_sid);

				for (let f in NET_FWDS[key])
					uci.delete('firewall', f[0]);
			}

			let rules = [];

			for (let t in keys(RULE_SIDS))
				uci.foreach('network', t, (r) => {
					if (index(r['.name'], 'wgpasswall_rule') == 0)
						push(rules, r['.name']);
				});

			for (let sid in rules)
				uci.delete('network', sid);

			for (let sid in [ KS_SID, NO_V6_SID, OLD_MARK_SID, DNS_SID ])
				uci.delete('firewall', sid);

			unlink(DNS_NFT);
			system(`nft delete table inet ${DNS_TABLE} 2>/dev/null`);

			// the profiles' DNS servers go back onto their interfaces
			for (let id in profile_ids(uci)) {
				const dns = as_list(uci.get('wgpasswall', id, 'dns'));

				if (length(dns) && !length(as_list(uci.get('network', id, 'dns'))))
					uci.set('network', id, 'dns', dns);
			}

			if (wifi)
				push(after, 'wifi reload');

			for (let pkg in [ 'network', 'wireless', 'dhcp', 'firewall', 'wgpasswall' ])
				uci.save(pkg);

			// nothing needs Passwall now: its own settings come back
			const pw = pw_sync(uci);

			apply(uci, [ 'wgpasswall', 'network', 'wireless', 'dhcp', 'firewall', 'passwall' ], pw);
			// a job of its own: queued Passwall commands may be skipped
			run_locked(after);
			relay_restart();

			return { result: true };
		}
	}
};

return { 'luci.wgpasswall': methods };
